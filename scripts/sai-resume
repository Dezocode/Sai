#!/usr/bin/env bash
# sai-resume — reconstruct latest active SAI primary from durable repo state.
# referenced: scripts/lib/sai_auth_resume.py scripts/lib/sai_auth_resume_test.py
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
exec python3 "$ROOT/scripts/lib/sai_auth_resume.py" "$@"
