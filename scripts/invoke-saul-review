#!/usr/bin/env bash
# invoke-saul-review — GitHub Actions entry: load Saul Codex profile, invoke Codex.
# Prefer an installed local `codex` (self-hosted authenticated CLI).
# Optional OPENAI_API_KEY/CODEX_API_KEY is npx fallback only.
# Missing/failed Codex => disposition BLOCKED (never APPROVE).
# Reviewer implementation MUST come from SAI_TRUSTED_TREE when set (CTO-010).
# referenced: scripts/lib/sai_auth_saul_test.py
set -euo pipefail
if [ -n "${SAI_TRUSTED_TREE:-}" ] && [ -f "${SAI_TRUSTED_TREE}/scripts/lib/sai_auth_review.py" ]; then
  exec python3 "${SAI_TRUSTED_TREE}/scripts/lib/sai_auth_review.py" invoke "$@"
fi
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
exec python3 "$ROOT/scripts/lib/sai_auth_review.py" invoke "$@"
