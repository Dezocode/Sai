#!/usr/bin/env bash
# invoke-saul-review — GitHub Actions entry: load Saul Codex profile, invoke Codex.
# Prefer an installed local `codex` (self-hosted authenticated CLI).
# Optional OPENAI_API_KEY/CODEX_API_KEY is npx fallback only.
# Missing/failed Codex => disposition BLOCKED (never APPROVE).
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
exec python3 "$ROOT/scripts/lib/sai_auth_review.py" invoke "$@"
