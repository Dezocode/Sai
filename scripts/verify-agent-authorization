#!/usr/bin/env bash
# verify-agent-authorization — replay identity/lease/path/revision from Git.
# CI must not trust .git/sai-session.json.
# referenced: scripts/lib/sai_auth_rebind_test.py
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
exec python3 "$ROOT/scripts/lib/sai_auth_verify.py" "$@"
