#!/usr/bin/env bash
# freeze-trusted-reviewer-once — empty-dest first-writer freeze. Never HEAD.
# referenced: scripts/lib/sai_auth_trust_root.py scripts/lib/sai_auth_trust_root_test.py
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
exec python3 "$ROOT/scripts/lib/sai_auth_trust_root.py" --freeze-once "$@"
