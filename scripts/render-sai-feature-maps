const ENRICHED=new Set();
function ghGo(now){
  return ghDue(now,GH_LAST_POLL,GH_REMAIN,GH_RESET_AT,GH_POLL_MS,GH_MIN_REMAIN)&&ghStepDue(now,GH_REMAIN,GH_RESET_AT,GH_MIN_REMAIN,GH_WINDOW_USED,GH_WINDOW_BUDGET,GH_WINDOW_AT,GH_WINDOW_MS);
}
async function enrich(cards){ // Budgeted, sequential (no fan-out); per-step rate gate (round-14).
  const steps=planEnrich(cards,REQUEST_BUDGET);
  for(const s of steps){
    if(!ghStepDue(Date.now(),GH_REMAIN,GH_RESET_AT,GH_MIN_REMAIN,GH_WINDOW_USED,GH_WINDOW_BUDGET,GH_WINDOW_AT,GH_WINDOW_MS))break;
    if(s.kind==="detail")await refreshDetail(s.k);
    else await refreshChecks(s.k);
  }
  for(const sha of doneShas(cards))ENRICHED.add(sha);
}
async function load(){
  let list,multi;
  try{
    const fed=await loadPrs();
    list=fed.list;multi=fed.multi;
  }catch(err){
    list=null;multi=false;
    loadErr=err&&err.message?err.message:String(err);
  }
  if(list!=null){
    SESSIONS_OK=true; // Round-13/14: GitHub plane gates on cadence + rate-limit + window budget.
    const now=Date.now();const go=ghGo(now);
    if(go){GH_LAST_POLL=now;await loadPulls();}
    let cards=assemble(list);
    if(go)await enrich(cards);
    cards=assemble(list);
    renderWheel(cards,list);SUMMARY.innerHTML=summaryHTML(cards,list);
    NOTE.textContent="count="+list.length+" · src="+(multi?"prs (multi-agent)":"sessions (fallback)")
      +(SRC==="prs"?"":" · prs feed unavailable")+" · github="+describeGh()+" · live GET · sessions 60s · github "
      +Math.round(GH_POLL_MS/60000)+"m"+(go?"":" · github poll throttled")+" · no secrets, nothing invented";
  }else{
    SESSIONS_OK=false;
    const now=Date.now();const go=ghGo(now);
    if(go){GH_LAST_POLL=now;await loadPulls();}
    let cards=assemble([]);
    if(go)await enrich(cards);
    cards=assemble([]);
    renderWheel(cards,[]);
    SUMMARY.innerHTML=summaryHTML(cards,[]);
    NOTE.textContent="sessions unavailable ("+loadErr+") · github="+describeGh()+" · nothing shown is invented";
  }
}
load();
setInterval(load,60000);
