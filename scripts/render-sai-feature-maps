# ROLLUP_JS: single source for the check-run rollup (newest attempt per check
# by stable id/attempt order). Spliced into page + selftest; backslash-free.
ROLLUP_JS = """
function rollupChecks(runs){
  // Newest attempt per check name wins: a green rerun clears an earlier failure.
  const newest=new Map();
  const rank=x=>{if(!x)return null;
    const id=Number(x.id);if(Number.isFinite(id)&&id>0)return [2,id];
    const at=Number(x.attempt);if(Number.isFinite(at)&&at>0)return [1,at];
    const t=String(x.started_at||x.completed_at||"");return t?[0,t]:null;};
  const cmp=(a,b)=>{if(a===null)return b===null?0:-1;if(b===null)return 1;
    for(let i=0;i<2;i++){if(a[i]!==b[i])return a[i]<b[i]?-1:1;}return 0;};
  for(const c of runs){
    if(!c||!c.name)continue;
    const name=String(c.name);
    const cur=newest.get(name);
    // Newest by stable monotone order, never timestamps alone (Saul P1).
    if(!cur||cmp(rank(c),rank(cur))>0)newest.set(name,c);
  }
  let total=0,fails=0,pending=0,saul=null;
  for(const c of newest.values()){
    total++;
    if(c.status&&c.status!=="completed"){pending++;continue;}
    const cc=String(c.conclusion||"").toLowerCase();
    if(cc==="failure"||cc==="timed_out"||cc==="action_required")fails++;
    if(/saul/i.test(String(c.name))){
      const t=String(c.completed_at||"");
      if(!saul||t>=String(saul.completed_at||""))saul=c;
    }
  }
  return {total:total,fails:fails,pending:pending,saul:saul};
}
"""
# Adversarial node harness for rollupChecks (P1: superseded FAIL must not stick).
SELFTEST_JS = """
function check(name,got,want){
  const ok=got===want;
  console.log((ok?"PASS ":"FAIL ")+name+"  got="+got+" want="+want);
  if(!ok)failures++;
}
let failures=0;
{
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"ci-verify-sai",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"}
  ]);
  check("P1 latest-wins total by name",r.total,1);
  check("P1 green rerun clears superseded failure",r.fails,0);
  check("P1 pending count",r.pending,0);
}
{
  // Saul P1 round-10: a newly QUEUED rerun reads pending, never superseded FAIL.
  const f={name:"build",id:97188392852,status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"};
  const q={name:"build",id:97199999999,status:"queued"};
  check("queued rerun supersedes failure (total)",rollupChecks([f,q]).total,1);
  check("queued rerun supersedes failure (fails)",rollupChecks([f,q]).fails,0);
  check("queued rerun reads as pending",rollupChecks([f,q]).pending,1);
  check("supersession independent of array order",rollupChecks([q,f]).fails+":"+rollupChecks([q,f]).pending,"0:1");
}
{
  // Attempt breaks ties when no ids ship; a ranked id beats timestamp-only.
  const idless=[{name:"deploy",attempt:1,status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},{name:"deploy",attempt:2,status:"in_progress"}];
  check("attempt orders id-less reruns",rollupChecks(idless).fails+":"+rollupChecks(idless).pending,"0:1");
  check("ranked id beats timestamp-only run",rollupChecks([{name:"icm-enforcement",status:"completed",conclusion:"success",started_at:"2099-01-01T00:00:00Z"},{name:"icm-enforcement",id:42,status:"queued"}]).fails+":"+rollupChecks([{name:"icm-enforcement",status:"completed",conclusion:"success",started_at:"2099-01-01T00:00:00Z"},{name:"icm-enforcement",id:42,status:"queued"}]).pending,"0:1");
}
{
  // Out-of-order arrival: latest-wins must use timestamps, not array order.
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"},
    {name:"ci-verify-sai",status:"completed",conclusion:"failure",started_at:"2026-08-23T02:00:00Z",completed_at:"2026-08-23T02:05:00Z"}
  ]);
  check("latest-wins timestamp not array order",r.fails,1);
  check("latest-wins total still 1",r.total,1);
}
{
  const r=rollupChecks([
    {name:"icm-enforcement",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"Anti-regression",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"}
  ]);
  check("distinct failures total",r.total,2);
  check("distinct failures fails",r.fails,2);
}
{
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"in_progress",started_at:"2026-08-23T03:00:00Z"}
  ]);
  check("pending run total",r.total,1);
  check("pending run pending",r.pending,1);
  check("pending run fails",r.fails,0);
}
{
  const r=rollupChecks([
    {name:"Saul / Product Quality",status:"completed",conclusion:"action_required",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"Saul / Product Quality",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"}
  ]);
  check("Saul latest-wins conclusion",r.saul&&r.saul.conclusion,"success");
  check("Saul latest-wins clears action_required",r.fails,0);
}
const DETAIL={};
const CHECKS={};
const DETAIL_TS={};
const DETAIL_FAIL={};
const REVALIDATE_MS=300000;
const MAX_DETAIL_FAILS=3;
const DETAIL_RETRY_MS=900000;
const DETAIL_RETRY_AT={};
let PULLS=null;
const ENRICHED=new Set();
const OC=(k,sha)=>sha?{k:k,pr:{state:"open",headSha:sha},ss:[{}]}:{k:k,pr:null,ss:[{}]};
{
  // Saul P1 round-6b: fan-out budget. 100 open PRs sharing 2 head SHAs must
  // plan at most REQUEST_BUDGET steps (not ~200), deduped by head SHA.
  const cards=[];  for(let i=1;i<=100;i++){cards.push({k:String(i),pr:{state:"open",merged:false,headSha:(i%2?"aa11":"bb22")},ss:[],agentState:"none"});}
  const steps=planEnrich(cards,24);
  check("budget caps planned enrichment steps",steps.length<=24,true);
  check("budget total never exceeds 24",steps.length,24);
  const kinds={};
  for(const s of steps)kinds[s.kind]=(kinds[s.kind]||0)+1;
  check("every step is detail or checks",(kinds.detail||0)+(kinds.checks||0),steps.length);
  const checkedShas=new Set();
  let redup=0;
  for(const s of steps){if(s.kind==="checks"){if(checkedShas.has(s.k))redup++;checkedShas.add(s.k);}}
  check("check steps deduped by head SHA",redup,0);
}
{
  const cards=[
    {k:"2",pr:{state:"open",merged:false,headSha:"cc33"},ss:[],agentState:"none"},
    {k:"1",pr:{state:"open",merged:false,headSha:"dd44"},ss:[{id:"s1"}],agentState:"fresh"}
  ];
  const steps=planEnrich(cards,4);
  const details=steps.filter(s=>s.kind==="detail");
  check("session card planned first",details[0].k,"1");
  check("open card planned second",details[1].k,"2");
}
{
  const cards=[
    {k:"9",pr:{state:"closed",merged:false,headSha:"ee55"},ss:[],agentState:"none"},
    {k:"10",pr:{state:"open",merged:true,headSha:"ff66"},ss:[],agentState:"none"}
  ];
  const steps=planEnrich(cards,4);
  check("closed+merged PRs skipped by planner",steps.length,0);
}
{
  // Round-9 (Steer 11:26): doneShas must not mark a pass-1 detail-only HEAD.
  const cards=[OC("77")];  let steps=planEnrich(cards,4);
  check("session-only card plans a detail by number",steps.some(s=>s.kind==="detail"&&s.k==="77"),true);
  check("no checks before a HEAD is known",steps.some(s=>s.kind==="checks"),false);
  DETAIL["77"]={headSha:"CAFE12"};
  for(const sha of doneShas(cards))ENRICHED.add(sha);
  check("detail-only card NOT done pre-checks (shipped order)",ENRICHED.has("cafe12"),false);
  steps=planEnrich(cards,4);
  check("known-detail card does not refetch detail",steps.some(s=>s.kind==="detail"),false);
  check("cached-HEAD card now plans checks",steps.some(s=>s.kind==="checks"&&s.k==="77"),true);
  CHECKS["cafe12"]={total:1,fails:0,pending:0,saul:"success (no blocking findings)"};
  for(const sha of doneShas(cards))ENRICHED.add(sha);
  check("card done once check-runs fetched",ENRICHED.has("cafe12"),true);
  check("done HEAD stops replanning",planEnrich(cards,4).length,0);
}
{
  // Round-8 #2: force-push replans detail + checks (shipped order).
  DETAIL["5"]={headSha:"AA11"};
  ENRICHED.add("aa11");
  check("stale-masked card stays done pre-detection",planEnrich([OC("5","aa11")],4).length,0);
  const steps=planEnrich([OC("5","BB22")],4);
  check("divergent listing HEAD replans detail",steps.some(s=>s.kind==="detail"&&s.k==="5"),true);
  check("divergent listing HEAD replans checks",steps.some(s=>s.kind==="checks"),true);
  DETAIL["5"]={headSha:"BB22"};
  CHECKS["bb22"]={total:1,fails:0,pending:0};
  const mixed=[OC("77"),OC("5","bb22"),{k:"9",pr:{state:"closed",headSha:"ee55"},ss:[]}];
  for(const sha of doneShas(mixed))ENRICHED.add(sha);
  check("steady-state replans nothing after 100 cycles",(function(){for(let i=0;i<100;i++){if(planEnrich(mixed,24).length)return 1;}return 0;})(),0);
}
{
  // Round-11 P1-1 (Saul 97192397931): stale session-only HEAD replans detail.
  PULLS=new Map();
  const c=OC("77");
  DETAIL["77"]={headSha:"CAFE12"};DETAIL_TS["77"]=Date.now()-REVALIDATE_MS-1;
  ENRICHED.add("cafe12");CHECKS["cafe12"]={total:1,fails:0,pending:0};
  let st=planEnrich([c],4);
  check("stale session-only replans detail",st.some(s=>s.kind==="detail"&&s.k==="77"),true);
  check("stale session-only replans checks",st.some(s=>s.kind==="checks"),true);
  DETAIL_TS["77"]=Date.now();
  check("fresh session-only stays done",planEnrich([c],4).length,0);
}
{
  // Round-11 P1-2 (Saul 97192397931): a failed DETAIL fetch backs off, not replan.
  PULLS=new Map([["42",{}]]);  const c=OC("42","CC33");
  DETAIL["42"]=null;DETAIL_FAIL["42"]=MAX_DETAIL_FAILS;
  const st=planEnrich([c],4);
  check("failed-detail card backs off detail",st.some(s=>s.kind==="detail"&&s.k==="42"),false);
  check("failed-detail card still plans checks",st.some(s=>s.kind==="checks"),true);
  CHECKS["cc33"]={total:1,fails:0,pending:0};
  const done=doneShas([c]);
  check("null-detail card done via listing head",done.indexOf("cc33")>=0,true);
  for(const s of done)ENRICHED.add(s);
  check("null-detail card reaches steady state",planEnrich([c],4).length,0);
  const c2=OC("43","DD44");DETAIL["43"]=null;DETAIL_FAIL["43"]=1;
  check("below-cap failure still retries detail",planEnrich([c2],4).some(s=>s.kind==="detail"),true);
}
{
  // Round-12 (Saul 97194598684): cap = backoff - capped stale card probes after DETAIL_RETRY_MS.
  PULLS=new Map();
  const c=OC("77");
  DETAIL["77"]={headSha:"CAFE12"};DETAIL_TS["77"]=Date.now()-REVALIDATE_MS-1;
  ENRICHED.add("cafe12");CHECKS["cafe12"]={total:1,fails:0,pending:0};
  DETAIL_FAIL["77"]=MAX_DETAIL_FAILS;
  DETAIL_RETRY_AT["77"]=Date.now()+DETAIL_RETRY_MS+1000;
  check("capped card backs off before probe window",planEnrich([c],4).some(s=>s.kind==="detail"&&s.k==="77"),false);
  DETAIL_RETRY_AT["77"]=Date.now()-1;
  check("capped card probes once window elapses",planEnrich([c],4).some(s=>s.kind==="detail"&&s.k==="77"),true);
  DETAIL["77"]={headSha:"BEEF00"};DETAIL_TS["77"]=Date.now();DETAIL_FAIL["77"]=0;delete DETAIL_RETRY_AT["77"];
  let st=planEnrich([c],4);
  check("refreshed card replans checks on new HEAD",st.some(s=>s.kind==="checks"&&s.k==="77"),true);
  CHECKS["beef00"]={total:1,fails:0,pending:0};
  for(const s of doneShas([c]))ENRICHED.add(s);
  check("refreshed card reaches steady state",planEnrich([c],4).length,0);
}
{
  // Round-13 (Saul 97206101278): ghDue = poll cadence + rate-limit hold.
  check("ghDue first load polls",ghDue(1000000,0,null,0,300000,5),true);
  check("ghDue holds inside window",ghDue(1000000,800000,null,0,300000,5),false);
  check("ghDue allows after window",ghDue(1000000,700000,null,0,300000,5),true);
  check("ghDue blocks when exhausted until reset",ghDue(1000000,0,0,2000000,300000,5),false);
  check("ghDue resumes after reset",ghDue(2500000,0,0,2000000,300000,5),true);
  check("ghDue blocks below floor until reset",ghDue(1000000,0,3,2000000,300000,5),false);
  check("ghDue below floor resumes after reset",ghDue(2500000,0,3,2000000,300000,5),true);
}
{
  // Round-14/15 (Saul 97215420702/97218921375): per-step gate stops a batch.
  check("ghStepDue blocks below floor",ghStepDue(1000000,4,2000000,5,0,60,0,3600000),false);
  check("ghStepDue budget holds w/o reset header",ghStepDue(1000000,40,0,5,60,60,900000,3600000),false);
  check("ghStepDue budget holds w/o reset AND w/o remaining",ghStepDue(1000000,null,0,5,60,60,900000,3600000),false);
  check("ghStepDue local roll resumes",ghStepDue(5000000,40,0,5,60,60,900000,3600000),true);
  let rem=7,used=0,ran=0;for(;ran<24;ran++){if(!ghStepDue(1000000,rem,2000000,5,used,60,900000,3600000))break;rem--;used++;}
  check("mid-batch floor stop (pre-fix 24)",ran,3);
  let ub=58,rb=0;for(;rb<24;rb++){if(!ghStepDue(1000000,40,0,5,ub,60,900000,3600000))break;ub++;}
  check("mid-batch budget stop w/o reset (pre-fix 24)",rb,2);
}
if(failures){console.error(failures+" selftest failure(s)");process.exit(1);}
console.log("ALL PASS");
"""
# Rounds 8-15: pending-selection in planEnrich; session-only detail by number;
# force-push replans; doneShas marks done; ghStepDue gates each request.
ENRICH_JS = """
function enrichPrio(c){
  if(c.ss&&c.ss.length)return 0;
  if(c.pr&&c.pr.state==="open"&&!c.pr.merged)return 1;
  return 2;
}
function planEnrich(cards,budget){
  const steps=[];const checked=new Set();let b=budget;const now=Date.now();
  for(const c of cards.filter(c=>c.k!=="?").sort((a,b)=>enrichPrio(a)-enrichPrio(b))){
    if(b<=0)break;
    const pr=c.pr;
    if(!(c.ss&&c.ss.length)&&!(pr&&pr.state==="open"&&!pr.merged))continue;
    const det=DETAIL[c.k];
    const ls=pr&&pr.headSha?String(pr.headSha).toLowerCase():"";
    const cs=det&&det.headSha?String(det.headSha).toLowerCase():"";
    const sha=ls||cs;
    // P1-1: session-only cards revalidate detail on a TTL once ever fetched.
    const inPulls=!!(PULLS&&PULLS.get(String(c.k)));
    const dts=DETAIL_TS[c.k];
    const stale=!inPulls&&det&&dts&&(now-dts)>REVALIDATE_MS;
    if(sha&&ENRICHED.has(sha)&&!stale)continue;
    const failed=(DETAIL_FAIL[c.k]||0)>=MAX_DETAIL_FAILS;
    // Round-12: cap = backoff, not lockout - probe after DETAIL_RETRY_MS (Saul 97194598684).
    const probe=!!DETAIL_RETRY_AT[c.k]&&now>=DETAIL_RETRY_AT[c.k];
    if(!det||det===null||(ls&&cs&&ls!==cs)||stale){
      if(!failed||probe){b--;steps.push({kind:"detail",k:c.k});if(b<=0)break;}
    }
    if(sha&&!checked.has(sha)){checked.add(sha);if(b>0){b--;steps.push({kind:"checks",k:c.k});}}
  }
  return steps;
}
function doneShas(cards){
  // Same SHA resolution as planEnrich; DONE = check-runs fetched for that HEAD.
  const out=[];
  for(const c of cards){
    const det=DETAIL[c.k];
    const ls=c.pr&&c.pr.headSha?String(c.pr.headSha).toLowerCase():"";
    const cs=det&&det.headSha?String(det.headSha).toLowerCase():"";
    const sha=ls||cs;if(sha&&CHECKS[sha]!==undefined)out.push(sha);
  }
  return out;
}
function ghDue(now,lastPoll,remain,resetAt,pollMs,minRem){
  // Round-13 (Saul 97206101278): cadence <=pollMs; hold until reset below floor.
  if(remain!=null&&now<resetAt&&(remain<=0||remain<minRem))return false;
  return now-lastPoll>=pollMs;
}
function ghStepDue(now,remain,resetAt,minRem,windowUsed,windowBudget,windowAt,windowMs){
  // Round-15: floor + per-window budget; windowAt anchors it without a reset header.
  if(remain!=null&&now<resetAt&&remain<minRem)return false;
  return !(windowUsed>=windowBudget&&!(resetAt>0&&now>=resetAt)&&!(windowAt>0&&now-windowAt>=windowMs));
}
