# Plain (non-f-string) on purpose: real JS braces. Inserted verbatim.
# Deliberately backslash-free (literal UTF-8 punctuation, String.fromCharCode
# for quote keys) so the JS-in-Python splice cannot lose an escape level.
# ROLLUP_JS is the single source for the check-run rollup: spliced into the
# page AND into the --selftest node harness, so the test drives the exact
# shipped function (adversarial fixture: superseded failed attempt followed by
# a green rerun of the same check name must roll up to latest-wins).
ROLLUP_JS = """
function rollupChecks(runs){
  // GitHub returns every historical attempt plus reruns for the same check
  // name; keep only the newest attempt per check so a successful rerun
  // clears an earlier failure instead of being double-counted.
  const newest=new Map();
  for(const c of runs){
    if(!c||!c.name)continue;
    const name=String(c.name);
    const cur=newest.get(name);
    const ts=x=>String((x&&x.started_at)||(x&&x.completed_at)||"");
    if(!cur||ts(c)>=ts(cur))newest.set(name,c);
  }
  let total=0,fails=0,pending=0,saul=null;
  for(const c of newest.values()){
    total++;
    if(c.status&&c.status!=="completed"){pending++;continue;}
    const cc=String(c.conclusion||"").toLowerCase();
    if(cc==="failure"||cc==="timed_out"||cc==="action_required")fails++;
    if(/saul/i.test(String(c.name))){
      const t=String(c.completed_at||"");
      if(!saul||t>=String(saul.completed_at||""))saul=c;
    }
  }
  return {total:total,fails:fails,pending:pending,saul:saul};
}
"""
# Adversarial node harness for rollupChecks (P1 regression: a superseded
# failed attempt must not keep CI failed after a green rerun of the same
# check name). Backslash-free like SESSIONS_JS.
SELFTEST_JS = """
function check(name,got,want){
  const ok=got===want;
  console.log((ok?"PASS ":"FAIL ")+name+"  got="+got+" want="+want);
  if(!ok)failures++;
}
let failures=0;
{
  // P1: same check name, superseded failure first, green rerun second.
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"ci-verify-sai",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"}
  ]);
  check("P1 latest-wins total by name",r.total,1);
  check("P1 green rerun clears superseded failure",r.fails,0);
  check("P1 pending count",r.pending,0);
}
{
  // Out-of-order arrival: array lists green first, failing rerun last with
  // a LATER started_at - latest-wins must use timestamps, not array order.
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"},
    {name:"ci-verify-sai",status:"completed",conclusion:"failure",started_at:"2026-08-23T02:00:00Z",completed_at:"2026-08-23T02:05:00Z"}
  ]);
  check("latest-wins timestamp not array order",r.fails,1);
  check("latest-wins total still 1",r.total,1);
}
{
  // Distinct failing checks are all counted.
  const r=rollupChecks([
    {name:"icm-enforcement",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"Anti-regression",status:"completed",conclusion:"failure",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"}
  ]);
  check("distinct failures total",r.total,2);
  check("distinct failures fails",r.fails,2);
}
{
  // Pending run is pending, never a failure.
  const r=rollupChecks([
    {name:"ci-verify-sai",status:"in_progress",started_at:"2026-08-23T03:00:00Z"}
  ]);
  check("pending run total",r.total,1);
  check("pending run pending",r.pending,1);
  check("pending run fails",r.fails,0);
}
{
  // Saul latest-wins: superseded action_required then success with counts.
  const r=rollupChecks([
    {name:"Saul / Product Quality",status:"completed",conclusion:"action_required",started_at:"2026-08-23T00:00:00Z",completed_at:"2026-08-23T00:05:00Z"},
    {name:"Saul / Product Quality",status:"completed",conclusion:"success",started_at:"2026-08-23T01:00:00Z",completed_at:"2026-08-23T01:05:00Z"}
  ]);
  check("Saul latest-wins conclusion",r.saul&&r.saul.conclusion,"success");
  check("Saul latest-wins clears action_required",r.fails,0);
}
if(failures){console.error(failures+" selftest failure(s)");process.exit(1);}
console.log("ALL PASS");
"""
SESSIONS_JS = """
const STALE_MIN=30;
const GH_API="https://api.github.com/repos/Dezocode/Sai";
const GH_WEB="https://github.com/Dezocode/Sai";
const GH_PULL="https://github.com/Dezocode/Sai/pull/";
const SESSIONS_URL="__API__";
const FIELDS=["profile","status","phase","head","heartbeat","steer","monitors"];
const WHEEL=document.getElementById("wheel");
const NOTE=document.getElementById("note");
const SUMMARY=document.getElementById("summary");
const ETAGS={};
const DETAIL={};
const CHECKS={};
let PULLS=null;
let PULLS_ERR="";
let SESSIONS_OK=false;
const ESCMAP={};
ESCMAP["&"]="&amp;";ESCMAP["<"]="&lt;";ESCMAP[">"]="&gt;";ESCMAP[String.fromCharCode(34)]="&quot;";ESCMAP[String.fromCharCode(39)]="&#39;";
const esc=s=>String(s==null?"":s).replace(/[&<>"']/g,c=>ESCMAP[c]);
const dash=s=>(s==null||s===""?"—":s);
const stCls=s=>({active:"ok",finished:"ok",done:"mute",failed:"bad"}[String(s||"").toLowerCase()]||"warn");
function ageMin(iso){const t=Date.parse(iso);if(isNaN(t))return null;return Math.max(0,Math.round((Date.now()-t)/60000));}
function age(iso){const m=ageMin(iso);if(m==null)return "";return m<60?m+"m ago":Math.round(m/60)+"h ago";}
function beatBucket(s){const m=ageMin(s&&s.heartbeat_at);return m==null?"missing":(m<STALE_MIN?"fresh":"stale");}
function isStale(s){return beatBucket(s)==="stale";}
function isMissing(s){return beatBucket(s)==="missing";}
function shortSha(x){x=String(x||"");return x.length>=7?x.slice(0,7):x;}
function ghJson(path,key){
  const headers={"Accept":"application/vnd.github+json"};
  if(ETAGS[key])headers["If-None-Match"]=ETAGS[key];
  return fetch(GH_API+path,{cache:"no-store",headers:headers}).then(r=>{
    if(r.status===304)return {notModified:true};
    const et=r.headers.get("ETag");if(et)ETAGS[key]=et;
    if(!r.ok)throw new Error("HTTP "+r.status+" for "+path);
    return r.json().then(j=>({data:j}));
  });
}
async function loadPulls(){
  try{
    const j=await ghJson("/pulls?state=all&per_page=100&sort=created&direction=desc","pulls");
    if(j.notModified)return;
    if(!Array.isArray(j.data))throw new Error("malformed GitHub pull-list payload");
    const map=new Map();
    for(const p of j.data){if(p&&p.number!=null)map.set(String(p.number),p);}
    PULLS=map;PULLS_ERR="";
  }catch(err){PULLS_ERR=err&&err.message?err.message:String(err);}
}
async function refreshDetail(num){
  try{
    const j=await ghJson("/pulls/"+num,"pr:"+num);
    if(j.notModified)return;
    const d=j.data||{};
    DETAIL[num]={title:d.title||"",state:d.state||"",draft:!!d.draft,mergedAt:d.merged_at||"",
      mergeable:d.mergeable,mergeableState:d.mergeable_state||"",
      headSha:d.head&&d.head.sha?d.head.sha:"",
      pushedAt:d.head&&d.head.repo&&d.head.repo.pushed_at||"",
      updatedAt:d.updated_at||""};
  }catch(err){if(DETAIL[num]===undefined)DETAIL[num]=null;}
}
__ROLLUP__
async function refreshChecks(num){
  const det=DETAIL[num];
  const sha=det&&det.headSha?det.headSha.toLowerCase():"";
  if(!sha)return;
  try{
    const j=await ghJson("/commits/"+sha+"/check-runs?per_page=100","ck:"+sha);
    if(j.notModified)return;
    const runs=(j.data&&j.data.check_runs)||[];
    const r=rollupChecks(runs);
    CHECKS[sha]={total:r.total,fails:r.fails,pending:r.pending,saul:saulLabel(r.saul)};
  }catch(err){if(CHECKS[sha]===undefined)CHECKS[sha]=null;}
}
function pcounts(text){
  if(!text)return null;
  const grab=(tag)=>{
    const i=text.indexOf(tag);if(i<0)return null;
    let j=i+tag.length,num="";
    while(j<text.length&&text[j]>="0"&&text[j]<="9"){num+=text[j];j++;}
    return num===""?null:num;
  };
  const p0=grab("P0="),p1=grab("P1="),p2=grab("P2=");
  return (p0==null||p1==null||p2==null)?null:{p0:p0,p1:p1,p2:p2};
}
function saulLabel(c){
  if(!c)return "";
  const pc=pcounts(c.output&&c.output.summary);
  if(pc)return "P0="+pc.p0+" P1="+pc.p1+" P2="+pc.p2;
  const cc=String(c.conclusion||"");
  return cc==="success"?"success (no blocking findings)":(cc||"unknown");
}
function normalize(k){
  const raw=PULLS?PULLS.get(k):undefined;
  const det=DETAIL[k];
  if(!raw&&det===undefined)return null;
  return {
    title:(det&&det.title)||(raw&&raw.title)||"",
    state:raw?String(raw.state):(det&&det.state?det.state:"unknown"),
    draft:raw?!!raw.draft:(det?!!det.draft:false),
    merged:raw?!!raw.merged_at:(det?!!det.mergedAt:false),
    headSha:(det&&det.headSha)||(raw&&raw.head&&raw.head.sha)||"",
    pushedAt:(det&&det.pushedAt)||(raw&&raw.head&&raw.head.repo&&raw.head.repo.pushed_at)||"",
    updatedAt:(det&&det.updatedAt)||(raw&&raw.updated_at)||"",
    mergeable:det?det.mergeable:undefined,
    mergeableState:det?det.mergeableState:""
  };
}
function assemble(list){
  const byPr=new Map();
  for(const s of list){const k=s&&s.pr!=null?String(s.pr):"?";if(!byPr.has(k))byPr.set(k,[]);byPr.get(k).push(s);}
  const keys=new Set(byPr.keys());
  if(PULLS)for(const k of PULLS.keys())keys.add(k);
  // DETAIL is enrichment-only: never add its keys to the union, or a PR
  // discovered via a session would keep rendering (as Agent NONE) after the
  // session disappears and it leaves both current data planes.
  const arr=Array.from(keys);
  arr.sort((a,b)=>((b==="?"?-1:parseInt(b,10))-(a==="?"?-1:parseInt(a,10))));
  return arr.map(k=>{
    const ss=(byPr.get(k)||[]).slice().sort((x,y)=>String(x.id||"").localeCompare(String(y.id||"")));
    const pr=normalize(k);
    const mismatch=!!(pr&&pr.headSha&&ss.length&&ss.some(s=>{
      const h=String(s&&s.head||"").toLowerCase();
      return !!h&&!pr.headSha.toLowerCase().startsWith(h);
    }));
    const agentState=ss.length===0?(SESSIONS_OK?"none":"unknown"):(ss.some(isMissing)?"missing":(ss.some(isStale)?"stale":"fresh"));
    return {k:k,pr:pr,ss:ss,mismatch:mismatch,agentState:agentState};
  });
}
function cell(f,s){
  if(f==="status")return '<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span>';
  if(f==="steer"){const n=s.note?String(s.note):"";return n?'<span class="st warn">'+esc(n)+'</span>':'<span class="st mute">none reported</span>';}
  if(f==="heartbeat"){
    const b=beatBucket(s);const a=age(s.heartbeat_at);
    const cls=b==="fresh"?"hb-fresh":(b==="stale"?"hb-stale":"hb-missing");
    const label=b==="fresh"?("fresh"+(a?" · "+a:"")):(b==="stale"?("stale · last beat "+(a||"of unknown age")):"missing · never reported");
    return '<span class="'+cls+'" title="'+esc(s.heartbeat_at||"")+'">'+label+'</span>';
  }
  if(f==="monitors"){const m=Array.isArray(s.monitors)?s.monitors.join(", "):s.monitors;return esc(dash(m));}
  return esc(dash(s[f]));
}
function srow(s){
  return '<div class="srow"><div class="sid"><span>'+esc(dash(s.id))+'</span>'
    +'<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span></div>'
    +'<div class="fields">'+FIELDS.map(f=>'<div class="k2">'+esc(f)+'</div><div class="v2">'+cell(f,s)+'</div>').join("")+'</div></div>';
}
function stateBadge(pr){
  const label=pr.merged?"merged":(pr.state||"unknown");
  const cls=pr.merged?"mute":(pr.state==="open"?"ok":"mute");
  return '<span class="st '+cls+'">'+esc(label)+"</span>";
}
function reviewBadge(pr){
  if(pr.merged||pr.state!=="open")return "—";
  return '<span class="st '+(pr.draft?"warn":"ok")+'">'+esc(pr.draft?"draft":"ready")+"</span>";
}
function mergeView(pr){
  if(pr.mergeable===true)return pr.mergeableState&&pr.mergeableState!=="clean"?("mergeable · "+esc(pr.mergeableState)):"mergeable";
  if(pr.mergeable===false)return pr.mergeableState?("state: "+esc(pr.mergeableState)):"merge conflicts";
  if(pr.mergeableState)return "state: "+esc(pr.mergeableState);
  if(pr.state!=="open")return "—";
  return "unavailable";
}
function pushView(pr){
  const t=pr.pushedAt;
  if(!t)return "unavailable";
  return esc(age(t)||String(t).slice(0,10));
}
function updateView(pr){
  const t=pr.updatedAt;
  if(!t)return "unavailable";
  return esc(age(t)||String(t).slice(0,10));
}
function checksFor(pr){const sha=pr.headSha?pr.headSha.toLowerCase():"";return sha?CHECKS[sha]:undefined;}
function ciView(pr){
  const ck=checksFor(pr);
  if(!pr.headSha)return "unavailable";
  if(ck===undefined)return "loading…";
  if(ck===null)return "unavailable";
  if(!ck.total)return "no check runs";
  return esc(ck.total+" checks"+(ck.fails?" · "+ck.fails+" failed":"")+(ck.pending?" · "+ck.pending+" running":""));
}
function saulView(pr){
  const ck=checksFor(pr);
  if(!pr.headSha)return "unavailable";
  if(ck===undefined)return "loading…";
  if(ck===null)return "unavailable";
  if(!ck.total)return "absent";
  return esc(ck.saul||"absent");
}
function ghBody(c){
  const pr=c.pr;
  if(!pr)return '<p class="empty">GitHub PR data unavailable.</p>';
  const rows=[
    ["title",esc(pr.title||"—")],
    ["state",stateBadge(pr)],
    ["review",reviewBadge(pr)],
    ["PR head",esc(pr.headSha?shortSha(pr.headSha):"—")],
    ["CI",ciView(pr)],
    ["Saul / Product Quality",saulView(pr)],
    ["mergeability",mergeView(pr)],
    ["last push",pushView(pr)],
    ["updated",updateView(pr)]
  ];
  if(c.mismatch)rows.push(["worker HEAD",'<span class="mismatch">session HEAD ≠ PR HEAD — worker may be behind or ahead</span>']);
  return '<div class="fields">'+rows.map(r=>'<div class="k2">'+esc(r[0])+'</div><div class="v2">'+r[1]+'</div>').join("")+'</div>';
}
function prCard(c){
  const link='<a href="'+GH_PULL+encodeURIComponent(c.k)+'">'+(c.k==="?"?"PR ?":"PR #"+esc(c.k))+"</a>";
  const titleHtml=c.pr&&c.pr.title?" — "+esc(c.pr.title):"";
  let sub;
  if(c.agentState==="none"){
    sub='<p class="sub"><span class="noworker">Agent: NONE — no worker attached</span></p>';
  }else if(c.agentState==="unknown"){
    sub='<p class="sub"><span class="st warn">Agent: UNKNOWN — sessions unavailable; worker attachment unknown</span></p>';
  }else{
    const b={fresh:0,stale:0,missing:0};
    for(const s of c.ss)b[beatBucket(s)]++;
    sub='<p class="sub">'+c.ss.length+" session"+(c.ss.length===1?"":"s")
      +' · <span class="hb-fresh">'+b.fresh+" fresh</span>"
      +' · <span class="hb-stale">'+b.stale+" stale</span>"
      +' · <span class="hb-missing">'+b.missing+" missing</span>"
      +(c.mismatch?' · <span class="mismatch">session HEAD ≠ PR HEAD</span>':"")+"</p>";
  }
  let cardCls="pcard";
  if(c.agentState==="missing")cardCls+=" hb-missing-card";
  else if(c.agentState==="stale")cardCls+=" hb-stale-card";
  const ghSid='<div class="sid"><span>GitHub authority</span><span class="pill">Dezocode/Sai</span></div>';
  return '<article class="'+cardCls+'"><h2>'+link+titleHtml+"</h2>"+sub
    +c.ss.map(srow).join("")
    +'<div class="srow">'+ghSid+ghBody(c)+"</div></article>";
}
function group(cards){return cards.map(prCard).join("");}
function summaryHTML(cards,list){
  let open=0,openDraft=0,mergedN=0,closedN=0,sessionOnly=0,unknownKey=0,noneWorker=0,unknownWorker=0,mismatchN=0;
  for(const c of cards){
    if(c.k==="?"){unknownKey++;continue;}
    if(!c.pr){sessionOnly++;continue;}
    if(c.pr.merged)mergedN++;
    else if(c.pr.state==="open"){open++;if(c.pr.draft)openDraft++;}
    else closedN++;
    if(c.agentState==="none")noneWorker++;
    if(c.agentState==="unknown")unknownWorker++;
    if(c.mismatch)mismatchN++;
  }
  const hb={fresh:0,stale:0,missing:0};
  for(const s of list)hb[beatBucket(s)]++;
  const chips=['<span class="lbl">PR GRAPH</span>',
    '<span class="pill">cards: '+cards.length+'</span>',
    '<span class="pill">sessions: '+list.length+'</span>',
    '<span class="pill">open: '+open+(openDraft?" ("+openDraft+" draft)":"")+'</span>',
    '<span class="pill">merged: '+mergedN+'</span>',
    '<span class="pill">closed: '+closedN+'</span>',
    '<span class="pill">agent NONE: '+noneWorker+'</span>'];
  if(sessionOnly)chips.push('<span class="pill">session-only PRs: '+sessionOnly+'</span>');
  if(unknownKey)chips.push('<span class="pill">unmapped PR keys: '+unknownKey+'</span>');
  if(unknownWorker)chips.push('<span class="pill hb-stale">agent unknown: '+unknownWorker+'</span>');
  if(mismatchN)chips.push('<span class="pill hb-stale">HEAD mismatch: '+mismatchN+'</span>');
  chips.push('<span class="pill">heartbeats fresh(&lt;'+STALE_MIN+'m): '+hb.fresh+'</span>',
    '<span class="pill'+(hb.stale?" hb-stale":"")+'">stale: '+hb.stale+'</span>',
    '<span class="pill'+(hb.missing?" hb-missing":"")+'">missing: '+hb.missing+'</span>');
  return chips.join(" ");
}
function describeGh(){
  if(PULLS_ERR&&!PULLS)return "unavailable ("+PULLS_ERR+")";
  if(PULLS_ERR)return "partial ("+PULLS_ERR+")";
  if(PULLS)return PULLS.size+" PRs via public REST";
  return "unavailable";
}
function renderWheel(cards,list){
  if(cards.length){WHEEL.innerHTML='<div class="wheel">'+group(cards)+"</div>";return;}
  if(list.length){WHEEL.innerHTML='<p class="empty">No PR cards could be assembled; sessions exist but GitHub data is unavailable. Nothing shown is invented.</p>';return;}
  WHEEL.innerHTML='<p class="empty">No PRs and no sessions reported right now.</p>';
}
async function enrich(cards){
  await Promise.all(cards.filter(c=>c.k!=="?").map(async c=>{
    await refreshDetail(c.k);
    if(DETAIL[c.k]&&DETAIL[c.k].headSha)await refreshChecks(c.k);
  }));
}
async function load(){
  try{
    const r=await fetch(SESSIONS_URL,{cache:"no-store"});
    if(!r.ok)throw new Error("HTTP "+r.status);
    const d=await r.json();
    if(!d||!Array.isArray(d.sessions))throw new Error("malformed sessions payload");
    const list=d.sessions;
    SESSIONS_OK=true;
    await loadPulls();
    let cards=assemble(list);
    await enrich(cards);
    cards=assemble(list);
    renderWheel(cards,list);
    SUMMARY.innerHTML=summaryHTML(cards,list);
    NOTE.textContent="count="+list.length+(d&&d.updated_at?" · updated_at="+d.updated_at:"")
      +" · github="+describeGh()+" · live GET · refreshes every 60s · no secrets, nothing invented";
  }catch(err){
    const msg=err&&err.message?err.message:String(err);
    SESSIONS_OK=false;
    await loadPulls();
    let cards=assemble([]);
    await enrich(cards);
    cards=assemble([]);
    renderWheel(cards,[]);
    SUMMARY.innerHTML=summaryHTML(cards,[]);
    NOTE.textContent="sessions unavailable ("+msg+") · github="+describeGh()+" · nothing shown is invented";
  }
}
load();
setInterval(load,60000);
""".replace("__API__", SESSIONS_API).replace("__ROLLUP__", ROLLUP_JS)


def git(root: Path, *args: str) -> str:
    cp = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True)
    return cp.stdout.strip() if cp.returncode == 0 else ""


def e(text: str) -> str:
    return html.escape(text, quote=True)


def items_ul(items: list[str]) -> str:
    if not items:
        return '<p class="empty">None listed on this HEAD.</p>'
    return "<ul>" + "".join(f"<li>{e(x)}</li>" for x in items) + "</ul>"


def subs_ul(subs: list[tuple[str, str]]) -> str:
    if not subs:
        return '<p class="empty">None listed on this HEAD.</p>'
    rows = []
    for sid, rest in subs:
        extra = f" {e(rest)}" if rest else ""
        rows.append(f'<li><span class="id">{e(sid)}</span>{extra}</li>')
    return "<ul>" + "".join(rows) + "</ul>"


def feat_section(title: str, inner: str) -> str:
    return f'<section class="sec"><h2>{e(title)}</h2>{inner}</section>'


def load_kernel_maps(root: Path) -> tuple[list[dict], list[str], str]:
    cmd = ["go", "run", "./cmd/sai-verify", "maps", "--root", str(root)]
    try:
        cp = subprocess.run(cmd, cwd=root, text=True, capture_output=True)
    except FileNotFoundError as exc:
        raise SystemExit(
            "render-sai-feature-maps: go is required to consume cmd/sai-verify maps"
        ) from exc
    if cp.returncode != 0:
        err = (cp.stderr or cp.stdout or "sai-verify maps failed").strip()
        raise SystemExit("render-sai-feature-maps: " + err)
    try:
        payload = json.loads(cp.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is invalid") from exc
    if not isinstance(payload, dict):
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is not an object")
    feats: list[dict] = []
    for raw in payload.get("features") or []:
        if not isinstance(raw, dict):
            continue
        subs: list[tuple[str, str]] = []
        for pair in raw.get("subfeatures") or []:
            if isinstance(pair, (list, tuple)) and len(pair) >= 1:
                sid = str(pair[0])
                rest = str(pair[1]) if len(pair) > 1 else ""
                subs.append((sid, rest))
        feats.append(
            {
                "id": str(raw.get("id") or ""),
                "file": str(raw.get("file") or ""),
                "title": str(raw.get("title") or ""),
                "desc": str(raw.get("desc") or ""),
                "subs": subs,
                "ents": [str(x) for x in (raw.get("entry_points") or [])],
                "proofs": [str(x) for x in (raw.get("proofs") or [])],
                "gotchas": [str(x) for x in (raw.get("gotchas") or [])],
            }
        )
    drift = [str(x) for x in (payload.get("problems") or [])]
    if drift:
        raise SystemExit("render-sai-feature-maps: invalid map: " + "; ".join(drift))
    cap = str(payload.get("caption") or "")
    return feats, drift, cap


def load_checks(path: Path | None, root: Path, sha: str) -> list[dict]:
    rows: list[dict] = []
    if path and path.is_file():
        try:
            raw = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            raw = []
        rows = raw if isinstance(raw, list) else raw.get("check_runs", [])
    else:
        repo = git(root, "config", "--get", "remote.origin.url")
        m = re.search(r"github.com[:/]([^/]+/[^/.]+)", repo)
        slug = m.group(1) if m else "Dezocode/Sai"
        stdout = ""
        try:
            cp = subprocess.run(
                ["gh", "api", f"repos/{slug}/commits/{sha}/check-runs", "--paginate"],
                text=True,
                capture_output=True,
            )
            if cp.returncode == 0:
                stdout = cp.stdout.strip()
        except (FileNotFoundError, OSError):
            stdout = ""
        if stdout:
            try:
                blob = json.loads(stdout)
            except json.JSONDecodeError:
                blob = []
            if isinstance(blob, list):
                for part in blob:
                    if isinstance(part, dict):
                        rows.extend(part.get("check_runs", []) or ([part] if part.get("name") else []))
            else:
                rows = blob.get("check_runs", [])
    latest: dict[str, dict] = {}
    for r in rows:
        name = str(r.get("name") or "").strip()
        if not name:
            continue
        latest[name] = {
            "name": name,
            "conclusion": str(r.get("conclusion") or "").lower() or "unevaluated",
            "status": str(r.get("status") or ""),
        }
    out = list(latest.values())
    have = {c["name"] for c in out}
    for name in KNOWN_CHECKS:
        if name not in have:
            out.append({"name": name, "conclusion": "unevaluated", "status": ""})
    return out


def constitution(root: Path) -> list[tuple[str, str]]:
    return [(label, rel) for label, rel in CONSTITUTION if (root / rel).exists()]


def pill_class(conclusion: str) -> str:
    if conclusion in ("failure", "failed", "timed_out", "cancelled"):
        return "bad"
    if conclusion in ("action_required", "neutral", "stale"):
        return "warn"
    if conclusion in ("success", "passed"):
        return "ok"
    return "mute"


def render(root: Path, feats: list[dict], drift: list[str], cap: str, checks: list[dict], branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    nav_feat = ['<a class="on" data-id="readme" href="#readme">README.md</a>']
    nav_feat += [f'<a data-id="{e(f["id"])}" href="#{e(f["id"])}">{e(f["file"])}</a>' for f in feats]
    cons = constitution(root)
    nav_con = [f"<span>{e(label)}</span>" for label, _ in cons]
    cards = []
    for f in feats:
        cards.append(
            f'<article class="card" id="{e(f["id"])}">'
            f'<h2 class="feat">{e(f["title"])}</h2>'
            f'<p class="desc">{e(f["desc"])}</p>'
            f'{feat_section("Sub-features", subs_ul(f["subs"]))}'
            f'{feat_section("How to get to it", items_ul(f["ents"]))}'
            f'{feat_section("Driving it", items_ul(f["proofs"]))}'
            f'{feat_section("Gotchas", items_ul(f["gotchas"]))}'
            "</article>"
        )
    banner = ""
    if drift:
        items = "".join(f"<li>{e(x)}</li>" for x in drift)
        banner = (
            '<div class="drift"><strong>Docs drift.</strong> '
            f"Map index vs siblings on this HEAD:<ul>{items}</ul></div>"
        )
    check_rows = []
    for c in checks:
        conc = c["conclusion"] or "unevaluated"
        check_rows.append(
            f'<li><span>{e(c["name"])}</span>'
            f'<span class="st {pill_class(conc)}">{e(conc)}</span></li>'
        )
    check_note = (
        "Check names from GitHub when a token is present. No secrets. "
        "Missing conclusions stay unevaluated, never success."
    )
    sdl = (
        '<div class="sdl"><div class="sdl-k">app constitution (not Origin chrome)</div>'
        "<div>canvas #0F1115</div><div>accent #5B8CFF</div>"
        "<div>foundation-draft · featureUIAllowed=false</div>"
        "<div>Sai Design Language check is PR 73-only until that merges.</div></div>"
    )
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai feature maps</title>
{BASE_CSS}</head>
<body>
<header class="top">
  <div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs">
    <a class="on" href="{GH_WEB}">Code</a>
    <a href="{GH_WEB}/pulls">Pull Requests</a>
    <a href="{GH_WEB}/settings">Settings</a>
    <a href="#readme">Preview</a>
    <a href="pr-sessions.html">PR sessions</a>
  </nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div>
  <div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a>
</header>
<div class="shell">
  <aside class="side">
    <div class="k">VERIFY-SAI / FEATURES</div>
    <nav class="nav">{''.join(nav_feat)}</nav>
    <div class="k">CONSTITUTION</div>
    <nav class="nav">{''.join(nav_con) if nav_con else '<span>none on this HEAD</span>'}</nav>
  </aside>
  <main class="main">
    <h1 id="readme">Sai feature maps</h1>
    <p class="cap">{e(cap)} Origin-styled surface, not a second constitution. Canonical parser remains <code>cmd/sai-verify</code>.</p>
    {banner}
    {''.join(cards)}
  </main>
  <aside class="right">
    <div class="k">CHECKS · EXACT HEAD</div>
    <ul class="checks">{''.join(check_rows)}</ul>
    <p class="note">{e(check_note)}</p>
    <div class="k">SAI DESIGN LANGUAGE</div>
    {sdl}
    <p class="host">GitHub Pages on Dezocode/Sai (site is public). Hostinger stays Saul-go. Drive HTML is recovery only.</p>
  </aside>
</div>
<script>
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{{
  document.querySelectorAll('.nav a').forEach(x=>x.classList.toggle('on',x===a));
}}));
</script>
</body></html>
"""


def render_sessions(branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai PR sessions</title>
{BASE_CSS}
{SESSIONS_CSS}</head>
<body>
<header class="top">
  <div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs">
    <a href="{GH_WEB}">Code</a>
    <a href="index.html">Feature maps</a>
    <a class="on" href="pr-sessions.html">PR sessions</a>
    <a href="{GH_WEB}/pulls">Pull Requests</a>
  </nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div>
  <div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a>
</header>
<main class="main">
  <h1 id="readme">PR sessions</h1>
  <p class="cap">One place per Dezocode/Sai pull request: authoritative GitHub PR state joined by PR number with live Hermes agent sessions, one horizontally scrollable card per PR. Two read-only GETs run below - the secret-free public GitHub REST API and the sessions API; every field comes straight from those responses and stays blank or marked unavailable when missing. No secrets, no tokens, nothing invented.</p>
  <div class="psummary" id="summary" aria-live="polite"></div>
  <div class="wheelwrap" id="wheelwrap">
    <div class="wheel" id="wheel"><noscript><p class="empty">JavaScript disabled — live sessions cannot load.</p></noscript></div>
  </div>
  <p class="note" id="note">loading…</p>
  <p class="host">Sources: sessions <code>{e(SESSIONS_API)}</code> · GitHub authority <code>{e(GH_API)}</code> (public repo fields only). Generated at exact HEAD; the wheel fills in live in your browser. Hostinger stays Saul-go.</p>
</main>
<script>{SESSIONS_JS}</script>
</body></html>
"""


def write_site(out: Path, html_text: str, html_sessions: str) -> None:
    out.mkdir(parents=True, exist_ok=True)
    (out / "feature-maps.html").write_text(html_text, encoding="utf-8")
    (out / "index.html").write_text(html_text, encoding="utf-8")
    (out / "pr-sessions.html").write_text(html_sessions, encoding="utf-8")
    (out / ".nojekyll").write_text("", encoding="utf-8")


def verify(out: Path, feats: list[dict], html_text: str, html_sessions: str) -> None:
    problems: list[str] = []
    if not (out / ".nojekyll").is_file():
        problems.append("missing .nojekyll")
    if "#f8f8f8" not in html_text or "#34785c" not in html_text:
        problems.append("missing Origin chrome tokens")
    if "body{margin:0;background:var(--bg)" not in html_text:
        problems.append("body is not Origin canvas")
    if "Hostinger stays Saul-go" not in html_text:
        problems.append("missing Hostinger boundary")
    for heading in ("Sub-features", "How to get to it", "Driving it", "Gotchas"):
        if f"<h2>{heading}</h2>" not in html_text:
            problems.append("missing four-H2 heading " + heading)
    for f in feats:
        if f["title"] not in html_text:
            problems.append("missing title " + f["title"])
        if not f["subs"]:
            problems.append(f["id"] + " has no sub-features")
        for sid, rest in f["subs"]:
            if sid not in html_text:
                problems.append("missing sub-id " + sid)
            if rest and e(rest) not in html_text:
                problems.append("missing sub-rest " + sid)
        for kind, rows in (("ents", f["ents"]), ("proofs", f["proofs"]), ("gotchas", f["gotchas"])):
            for row in rows:
                if e(row) not in html_text:
                    problems.append("missing " + kind + " text in " + f["id"])
                    break
    if 'href="pr-sessions.html"' not in html_text:
        problems.append("feature-maps.html missing PR sessions tab link")
    if not (out / "pr-sessions.html").is_file():
        problems.append("missing pr-sessions.html")
    if len(html_sessions) < 200:
        problems.append("pr-sessions.html suspiciously small")
    sessions_needles = (
        SESSIONS_API,
        GH_API,
        GH_WEB,
        "overflow-x:auto",
        'id="wheel"',
        'id="summary"',
        "setInterval(load,60000)",
        'FIELDS=["profile","status","phase","head","heartbeat","steer","monitors"]',
        "/pulls?state=all&per_page=100",
        "If-None-Match",
        "Agent: NONE",
        "Agent: UNKNOWN",
        "success (no blocking findings)",
        'class="mismatch">session HEAD ≠ PR HEAD',
        "github.com/Dezocode/Sai/pull/",
        ".hb-fresh",
        ".hb-stale",
        ".hb-missing",
        "hb-missing-card",
        "missing · never reported",
        "<noscript>",
        "Hostinger stays Saul-go",
    )
    for needle in sessions_needles:
        if needle not in html_sessions:
            problems.append("pr-sessions.html missing " + needle)
    # Token names are legitimate prose inside the protected-ci feature map;
    # the enforcement point is the workflow env (renderer runs with tokens
    # unset), not output text. The sessions page we author here must never
    # reference tokens at all.
    if "X-Sessions-Token" in html_text:
        problems.append("feature-maps.html contains forbidden X-Sessions-Token")
    for banned in ("X-Sessions-Token", "GH_TOKEN", "GITHUB_TOKEN"):
        if banned in html_sessions:
            problems.append("pr-sessions.html contains forbidden " + banned)
    for guard in ("Agent: NONE", '"missing"', '"stale"', "no worker attached"):
        if guard not in html_sessions:
            problems.append("pr-sessions.html missing heartbeat/agent guard " + guard)
    if "api.github.com" not in html_sessions:
        problems.append("pr-sessions.html missing GitHub authority plane")
    if "Authorization" in html_sessions or "token " in html_sessions:
        problems.append("pr-sessions.html must stay token-free")
    if problems:
        raise SystemExit("render-sai-feature-maps --check failed:\n- " + "\n- ".join(problems))


def run_selftest() -> int:
    """Run the adversarial rollupChecks harness in node (exact shipped JS).

    Fail-loud if node is unavailable: the selftest is the regression net for
    the latest-wins check-run rollup (Saul P1), so skipping is never silent.
    """
    harness = ROLLUP_JS + SELFTEST_JS
    with tempfile.TemporaryDirectory(prefix="sai-rollup-selftest-") as tmp:
        js = Path(tmp) / "rollup_selftest.js"
        js.write_text(harness, encoding="utf-8")
        try:
            cp = subprocess.run(["node", str(js)], text=True, capture_output=True)
        except FileNotFoundError:
            raise SystemExit(
                "render-sai-feature-maps --selftest: node is required "
                "but not on PATH (cannot run adversarial rollup harness)"
            )
    sys.stdout.write(cp.stdout)
    if cp.returncode != 0:
        sys.stderr.write(cp.stderr or "")
        raise SystemExit("render-sai-feature-maps --selftest: node harness FAILED")
    print("OK render-sai-feature-maps --selftest: rollupChecks latest-wins harness ALL PASS")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", default=".")
    ap.add_argument("--out", default="")
    ap.add_argument("--checks", default="")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--branch", default="")
    ap.add_argument("--sha", default="")
    ns = ap.parse_args(argv)
    if ns.selftest:
        return run_selftest()
    root = Path(ns.root).resolve()
    os.chdir(root)
    feats, drift, cap = load_kernel_maps(root)
    if not feats:
        print("render-sai-feature-maps: no indexed features", file=sys.stderr)
        return 1
    sha = ns.sha or git(root, "rev-parse", "HEAD")
    branch = ns.branch or git(root, "rev-parse", "--abbrev-ref", "HEAD") or "HEAD"
    checks_path = Path(ns.checks) if ns.checks else None
    checks = load_checks(checks_path, root, sha)
    try:
        from zoneinfo import ZoneInfo

        when = datetime.now(ZoneInfo("America/Chicago")).strftime("%d %b %Y - %I:%M %p CT")
    except Exception:
        when = datetime.utcnow().strftime("%d %b %Y - %H:%M UTC")
    html_text = render(root, feats, drift, cap, checks, branch, sha, when)
    html_sessions = render_sessions(branch, sha, when)
    if ns.check:
        run_selftest()
        with tempfile.TemporaryDirectory(prefix="sai-feature-maps-") as tmp:
            out = Path(tmp)
            write_site(out, html_text, html_sessions)
            verify(out, feats, html_text, html_sessions)
        print("OK render-sai-feature-maps --check features=%d" % len(feats))
        return 0
    if not ns.out:
        print("render-sai-feature-maps: --out DIR required (or --check)", file=sys.stderr)
        return 2
    out = Path(ns.out)
    if not out.is_absolute():
        out = root / out
    write_site(out, html_text, html_sessions)
    print("wrote %s/feature-maps.html" % out)
    print("wrote %s/pr-sessions.html" % out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
