def git(root: Path, *args: str) -> str:
    cp = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True)
    return cp.stdout.strip() if cp.returncode == 0 else ""
def e(text: str) -> str:
    return html.escape(text, quote=True)
def items_ul(items: list[str]) -> str:
    if not items:return '<p class="empty">None listed on this HEAD.</p>'
    return "<ul>" + "".join(f"<li>{e(x)}</li>" for x in items) + "</ul>"
def subs_ul(subs: list[tuple[str, str]]) -> str:
    if not subs:return '<p class="empty">None listed on this HEAD.</p>'
    rows = []
    for sid, rest in subs:
        extra = f" {e(rest)}" if rest else ""
        rows.append(f'<li><span class="id">{e(sid)}</span>{extra}</li>')
    return "<ul>" + "".join(rows) + "</ul>"
def feat_section(title: str, inner: str) -> str:
    return f'<section class="sec"><h2>{e(title)}</h2>{inner}</section>'

def load_kernel_maps(root: Path) -> tuple[list[dict], list[str], str]:
    # "go run ./cmd/sai-verify maps" is the protected-ci ::contains needle; root stays one argv element.
    cmd = "go run ./cmd/sai-verify maps --root".split() + [str(root)]
    try:
        cp = subprocess.run(cmd, cwd=root, text=True, capture_output=True)
    except FileNotFoundError as exc:
        raise SystemExit("render-sai-feature-maps: go is required (cmd/sai-verify maps)") from exc
    if cp.returncode != 0:
        err = (cp.stderr or cp.stdout or "sai-verify maps failed").strip()
        raise SystemExit("render-sai-feature-maps: " + err)
    try:payload = json.loads(cp.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is invalid") from exc
    if not isinstance(payload, dict):
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is not an object")
    feats: list[dict] = []
    for raw in payload.get("features") or []:
        if not isinstance(raw, dict):
            continue
        subs: list[tuple[str, str]] = []
        for pair in raw.get("subfeatures") or []:
            if isinstance(pair, (list, tuple)) and len(pair) >= 1:
                subs.append((str(pair[0]), str(pair[1]) if len(pair) > 1 else ""))
        feats.append({
            "id": str(raw.get("id") or ""), "file": str(raw.get("file") or ""),
            "title": str(raw.get("title") or ""), "desc": str(raw.get("desc") or ""),
            "subs": subs,
            "ents": [str(x) for x in (raw.get("entry_points") or [])],
            "proofs": [str(x) for x in (raw.get("proofs") or [])],
            "gotchas": [str(x) for x in (raw.get("gotchas") or [])],
        })
    drift = [str(x) for x in (payload.get("problems") or [])]
    if drift: raise SystemExit("render-sai-feature-maps: invalid map: " + "; ".join(drift))
    cap = str(payload.get("caption") or "")
    return feats, drift, cap

def load_checks(path: Path | None, root: Path, sha: str) -> list[dict]:
    rows: list[dict] = []
    if path and path.is_file():
        try:raw = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:raw = []
        rows = raw if isinstance(raw, list) else raw.get("check_runs", [])
    else:
        repo = git(root, "config", "--get", "remote.origin.url")
        m = re.search(r"github.com[:/]([^/]+/[^/.]+)", repo)
        slug = m.group(1) if m else "Dezocode/Sai"
        stdout = ""
        try:
            cp = subprocess.run(["gh", "api", f"repos/{slug}/commits/{sha}/check-runs",
                                 "--paginate"], text=True, capture_output=True)
            if cp.returncode == 0:stdout = cp.stdout.strip()
        except (FileNotFoundError, OSError):stdout = ""
        if stdout:
            try:blob = json.loads(stdout)
            except json.JSONDecodeError:blob = []
            if isinstance(blob, list):
                for part in blob:
                    if isinstance(part, dict):
                        rows.extend(part.get("check_runs", []) or ([part] if part.get("name") else []))
            else:rows = blob.get("check_runs", [])
    latest: dict[str, dict] = {}
    for r in rows:
        name = str(r.get("name") or "").strip()
        if not name:continue
        latest[name] = {"name": name,
                        "conclusion": str(r.get("conclusion") or "").lower() or "unevaluated",
                        "status": str(r.get("status") or "")}
    out = list(latest.values());have = {c["name"] for c in out}
    for name in KNOWN_CHECKS:
        if name not in have:out.append({"name": name, "conclusion": "unevaluated", "status": ""})
    return out

def constitution(root: Path) -> list[tuple[str, str]]:
    return [(l, r) for l, r in CONSTITUTION if (root / r).exists()]

def pill_class(conclusion: str) -> str:
    if conclusion in ("failure", "failed", "timed_out", "cancelled"):return "bad"
    if conclusion in ("action_required", "neutral", "stale"):return "warn"
    return "ok" if conclusion in ("success", "passed") else "mute"

def render(root: Path, feats: list[dict], drift: list[str], cap: str, checks: list[dict], branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    nav_feat = ['<a class="on" data-id="readme" href="#readme">README.md</a>'] + [f'<a data-id="{e(f["id"])}" href="#{e(f["id"])}">{e(f["file"])}</a>' for f in feats]
    cons = constitution(root);nav_con = [f"<span>{e(label)}</span>" for label, _ in cons];cards = []
    for f in feats:
        cards.append(
            f'<article class="card" id="{e(f["id"])}">'
            f'<h2 class="feat">{e(f["title"])}</h2><p class="desc">{e(f["desc"])}</p>'
            f'{feat_section("Sub-features", subs_ul(f["subs"]))}'
            f'{feat_section("How to get to it", items_ul(f["ents"]))}'
            f'{feat_section("Driving it", items_ul(f["proofs"]))}'
            f'{feat_section("Gotchas", items_ul(f["gotchas"]))}'
            "</article>"
        )
    banner = ""
    if drift:
        items = "".join(f"<li>{e(x)}</li>" for x in drift)
        banner = '<div class="drift"><strong>Docs drift.</strong> ' + f"Map index vs siblings:<ul>{items}</ul></div>"
    check_note = "Check names from GitHub when a token is present. No secrets. Missing conclusions stay unevaluated, never success."
    check_rows = []
    for c in checks:
        conc = c["conclusion"] or "unevaluated"
        check_rows.append(f'<li><span>{e(c["name"])}</span><span class="st {pill_class(conc)}">{e(conc)}</span></li>')
    sdl = ('<div class="sdl"><div class="sdl-k">app constitution (not Origin chrome)</div>'
           "<div>canvas #0F1115</div><div>accent #5B8CFF</div><div>foundation-draft · featureUIAllowed=false</div>"
           "<div>Sai Design Language check is PR 73-only until that merges.</div></div>")
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai feature maps</title>
{BASE_CSS}</head><body>
<header class="top"><div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs"><a class="on" href="{GH_WEB}">Code</a><a href="{GH_WEB}/pulls">Pull Requests</a><a href="{GH_WEB}/settings">Settings</a><a href="#readme">Preview</a><a href="pr-sessions.html">PR sessions</a></nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div><div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a></header>
<div class="shell">
  <aside class="side">
    <div class="k">VERIFY-SAI / FEATURES</div>
    <nav class="nav">{''.join(nav_feat)}</nav>
    <div class="k">CONSTITUTION</div>
    <nav class="nav">{''.join(nav_con) if nav_con else '<span>none on this HEAD</span>'}</nav>
  </aside>
  <main class="main">
    <h1 id="readme">Sai feature maps</h1>
    <p class="cap">{e(cap)} Origin-styled surface, not a second constitution. Canonical parser remains <code>cmd/sai-verify</code>.</p>
    {banner}
    {''.join(cards)}
  </main>
  <aside class="right">
    <div class="k">CHECKS · EXACT HEAD</div>
    <ul class="checks">{''.join(check_rows)}</ul>
    <p class="note">{e(check_note)}</p>
    <div class="k">SAI DESIGN LANGUAGE</div>
    {sdl}
    <p class="host">GitHub Pages on Dezocode/Sai (site is public). Hostinger stays Saul-go. Drive HTML is recovery only.</p>
  </aside>
</div>
<script>document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{{document.querySelectorAll('.nav a').forEach(x=>x.classList.toggle('on',x===a));}}));</script>
</body></html>
"""

def render_sessions(branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    # Substitute both feed URLs into the shipped JS; e() keeps HTML-safe text.
    html = SESSIONS_JS.replace("__API__", e(SESSIONS_API)).replace("__PRS_API__", e(PRS_API))
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai PR sessions</title>
{BASE_CSS}{SESSIONS_CSS}</head><body>
<header class="top"><div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs"><a href="{GH_WEB}">Code</a><a href="index.html">Feature maps</a><a class="on" href="pr-sessions.html">PR sessions</a><a href="{GH_WEB}/pulls">Pull Requests</a></nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div><div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a></header>
<main class="main">
  <h1 id="readme">PR sessions</h1>
  <p class="cap">One place per Dezocode/Sai pull request: authoritative GitHub PR state joined by PR number with live Hermes agent sessions, one horizontally scrollable card per PR. Two read-only GETs run below - the secret-free public GitHub REST API and the sessions API; every field comes straight from those responses and stays blank or marked unavailable when missing. No secrets, no tokens, nothing invented.</p>
  <div class="psummary" id="summary" aria-live="polite"></div>
  <div class="wheelwrap" id="wheelwrap"><div class="wheel" id="wheel"><noscript><p class="empty">JavaScript disabled — live sessions cannot load.</p></noscript></div></div>
  <p class="note" id="note">loading…</p>
  <p class="host">Sources: multi-agent prs <code>{e(PRS_API)}</code> (preferred; flat sessions fallback) · GitHub authority <code>{e(GH_API)}</code> (public repo fields only). Generated at exact HEAD; the wheel fills in live in your browser. Hostinger stays Saul-go.</p>
</main>
<script>{html}</script>
</body></html>
"""

def write_site(out: Path, html_text: str, html_sessions: str) -> None:
    out.mkdir(parents=True, exist_ok=True)
    for name, txt in (("feature-maps.html", html_text), ("index.html", html_text),
                      ("pr-sessions.html", html_sessions), (".nojekyll", "")):
        (out / name).write_text(txt, encoding="utf-8")

def verify(out: Path, feats: list[dict], html_text: str, html_sessions: str) -> None:
    problems: list[str] = []
    if not (out / ".nojekyll").is_file():problems.append("missing .nojekyll")
    if "#f8f8f8" not in html_text or "#34785c" not in html_text:problems.append("missing Origin chrome tokens")
    if "body{margin:0;background:var(--bg)" not in html_text:problems.append("body is not Origin canvas")
    if "Hostinger stays Saul-go" not in html_text:problems.append("missing Hostinger boundary")
    for heading in ("Sub-features", "How to get to it", "Driving it", "Gotchas"):
        if f"<h2>{heading}</h2>" not in html_text:problems.append("missing four-H2 heading " + heading)
    for f in feats:
        if f["title"] not in html_text:problems.append("missing title " + f["title"])
        if not f["subs"]:problems.append(f["id"] + " has no sub-features")
        for sid, rest in f["subs"]:
            if sid not in html_text:problems.append("missing sub-id " + sid)
            if rest and e(rest) not in html_text:problems.append("missing sub-rest " + sid)
        for kind, rows in (("ents", f["ents"]), ("proofs", f["proofs"]), ("gotchas", f["gotchas"])):
            for row in rows:
                if e(row) not in html_text:problems.append("missing " + kind + " text in " + f["id"]);break
    if 'href="pr-sessions.html"' not in html_text:problems.append("feature-maps.html missing PR sessions tab link")
    if not (out / "pr-sessions.html").is_file():problems.append("missing pr-sessions.html")
    if len(html_sessions) < 200:problems.append("pr-sessions.html suspiciously small")
    sessions_needles = (
        SESSIONS_API, GH_API, GH_WEB, "overflow-x:auto", 'id="wheel"', 'id="summary"', "setInterval(load,60000)",
        'FIELDS=["profile","status","phase","head","heartbeat","steer","monitors","usage","diff"]',
        "/pulls?state=all&per_page=100", "If-None-Match", "X-RateLimit-Remaining", "ghDue(", "ghStepDue(",
        "sessions 60s · github ", "Agent: UNKNOWN", "success (no blocking findings)",
        'class="mismatch">session HEAD ≠ PR HEAD', "github.com/Dezocode/Sai/pull/", ".hb-fresh",
        ".hb-stale", ".hb-missing", "hb-missing-card", "<noscript>", "Hostinger stays Saul-go",
        '"monitors","usage","diff"', 'if(f==="usage")return usageView(s)', 'if(f==="diff")return diffView(s&&s.diff)',
        "<details><summary>files</summary>", '"st warn">dirty', "hermes-sessions/prs", "const PRS_URL=",
        ".tag{", ".saul{", "tagsView(s)+reviewView(s)", 'src="+(multi?"prs (multi-agent)":"sessions (fallback)")',
        "prs feed unavailable", "mergeability", "for(const k of PULLS.keys())keys.add(k)", "out.push({pr:p.pr,...a})",
        "const PRS_STALE_MIN=", "function agentOk(", "function reviewView(a){", "Saul review @ ",
        'cell("codex_invoked"', "agentOk(a)", '=="saul")return ""',
        "const CHECK_PAGES_MAX=", "/check-runs?per_page=100&page=", '" · partial"',
        "PAGE_CACHE", "if(p>1&&!ghStepDue(",
    )
    for needle in sessions_needles:
        if needle not in html_sessions:problems.append("pr-sessions.html missing " + needle)
    # Token names are legitimate prose in protected-ci; the pages we author here must never reference tokens.
    if "X-Sessions-Token" in html_text:problems.append("feature-maps.html contains forbidden X-Sessions-Token")
    for banned in ("X-Sessions-Token", "GH_TOKEN", "GITHUB_TOKEN"):
        if banned in html_sessions:problems.append("pr-sessions.html contains forbidden " + banned)
    for guard in ("Agent: NONE", '"missing"', '"stale"', "no worker attached"):
        if guard not in html_sessions:problems.append("pr-sessions.html missing heartbeat/agent guard " + guard)
    # STEER 20:18Z /prs acceptance probes drive the exact shipped SESSIONS_JS:
    # prefer (fresh valid rows incl. identity-gated Saul), empty prs, stale
    # updated_at, malformed row -> all fall back to /sessions; completed Saul
    # renders every review field. Payloads use json.dumps so nesting can never
    # unbalance the JS. Timestamps are UTC-derived relative to now so the
    # staleness gate is live; fetch is parked before SESSIONS_JS embed so its
    # eval-time self-load cannot hit the network (reviewer finding 5).
    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    stale_iso = (datetime.now(timezone.utc) - timedelta(minutes=45)).strftime("%Y-%m-%dT%H:%M:%SZ")
    park_fetch = "globalThis.__net=[];global.fetch=(u)=>{__net.push(String(u));return new Promise(()=>{});};\n"
    saul_agent = {"id": "rv1", "status": "finished", "agent": "Saul", "heartbeat_at": now_iso,
                  "review": {"conclusion": "success", "head_sha": "769e2f00d703a0a832a7b2731d0478d58216cb9c", "phase": "complete",
                             "progress": "done", "status": "success", "codex_invoked": True, "synthetic": False, "P0": "1", "P1": "2", "P2": "3"}}
    prs_payload = {"count": 1, "schema": "test", "updated_at": now_iso, "prs": [
        {"pr": 77, "agent_count": 2, "heads": ["769e2f0"], "updated_at": now_iso,
         "agents": [{"id": "w1", "status": "active", "tags": ["harness:hermes-cli", "model:test-model"],
                     "heartbeat_at": now_iso, "diff": None, "usage": None}, saul_agent]}]}
    bad_row = dict(prs_payload, prs=[{"pr": 77, "updated_at": now_iso, "agents": [{"id": "x", "status": "active"}]}])
    bare_saul = dict(prs_payload, prs=[{"pr": 77, "updated_at": now_iso, "agents": [{"id": "rv9", "status": "finished", "agent": "saul", "heartbeat_at": now_iso, "review": {}}]}])
    fb_payload = {"sessions": [{"id": "w2", "status": "active", "heartbeat_at": now_iso}]}
    def prs_body(payload):
        return ("global.fetch=async(u)=>String(u).indexOf('hermes-sessions/prs')>=0?J("
                + json.dumps(payload) + "):J(" + json.dumps(fb_payload) + ");")
    fallback_cases = "".join(
        prs_body(pay) + "W.innerHTML='';await load();if(N.textContent.indexOf('src=sessions (fallback)')<0)fail('" + lbl + " fallback');"
        for lbl, pay in (("empty", {"schema": "sai-sessions-v2", "updated_at": now_iso, "prs": []}),
                         ("stale", dict(prs_payload, updated_at=stale_iso)), ("badrow", bad_row)))
    js_probe = (
        "const __E={};const document={getElementById:(i)=>(__E[i]=__E[i]||{innerHTML:'',textContent:''})};\n"
        + park_fetch
        + SESSIONS_JS.replace("__API__", SESSIONS_API).replace("__PRS_API__", PRS_API)
        + "globalThis.__PROBE__=(async()=>{const J=(x)=>({ok:true,status:200,json:async()=>x});"
        + "const W=document.getElementById('wheel'),N=document.getElementById('note');const html=()=>W.innerHTML;const fail=(m)=>{console.log('FAIL '+m);process.exitCode=1;};"
        + "const setP=(p)=>{global.fetch=async(u)=>String(u).indexOf('hermes-sessions/prs')>=0?J("
        + json.dumps(prs_payload) + "):J(" + json.dumps(fb_payload) + ");};setP();W.innerHTML='';await load();"
        + "if(N.textContent.indexOf('src=prs (multi-agent)')<0)fail('prefer prs note');"
        + "if(html().indexOf('harness:hermes-cli'.slice(8))<0)fail('tag harness');"
        + "if(html().indexOf('model:test-model'.slice(6))<0)fail('tag model');"
        + "if(html().indexOf('Saul review @ ')<0)fail('saul head');"
        + "if(html().indexOf('codex_invoked')<0||html().indexOf('synthetic')<0)fail('saul fields');"
        + "if(html().indexOf('P0=1 P1=2 P2=3')<0)fail('saul counts');"
        + "if(html().indexOf('pull/77')<0)fail('parent-PR join');if(html().indexOf('PR ?')>=0)fail('ghost unknown card');"
        + fallback_cases
        + prs_body(bare_saul)
        + "W.innerHTML='';await load();if(html().indexOf('unavailable')<0)fail('bare saul unavailable');"
        + "if(html().indexOf('Saul review')<0)fail('bare saul gated-in');"
        + "global.fetch=async(u)=>String(u).indexOf('hermes-sessions/prs')>=0?{ok:false,status:503}:J("
        + json.dumps(fb_payload) + ");W.innerHTML='';await load();"
        + "if(N.textContent.indexOf('src=sessions (fallback)')<0)fail('down fallback note');"
        + "if(N.textContent.indexOf('count=1')<0)fail('fallback count');"
        + "})().catch(e=>{console.log('FAIL async '+(e&&e.message||e));process.exit(1);});"
        + "setTimeout(()=>{console.log(process.exitCode?'probe failed':'OK prs-probe:"
        + " prefer/empty/stale/badrow/bare-Saul/503 fallback assertions passed');process.exit(process.exitCode?1:0);},2000);"
    )
    with tempfile.TemporaryDirectory(prefix="sai-prs-probe-") as tmp:
        probe = Path(tmp) / "probe.js"
        probe.write_text(js_probe, encoding="utf-8")
        try:
            cp = subprocess.run(["node", str(probe)], text=True, capture_output=True, timeout=30)
        except FileNotFoundError:
            raise SystemExit("render-sai-feature-maps --check: node required for the /prs fallback probe")
    if cp.returncode != 0 or "FAIL" in (cp.stdout + cp.stderr):
        sys.stderr.write(cp.stdout + cp.stderr)
        problems.append("pr-sessions /prs fallback+tags+Saul probe failed")
    elif cp.stdout.strip():
        print(cp.stdout.strip().splitlines()[0])
    if "api.github.com" not in html_sessions:
        problems.append("pr-sessions.html missing GitHub authority plane")
    if "Merge readiness" not in html_sessions or "Implementation" not in html_sessions:
        problems.append("pr-sessions.html missing flight-board bar labels")
    if ".ftrack" not in html_sessions or "max-width:480px" not in html_sessions:
        problems.append("pr-sessions.html missing flight-board bar styles/narrow-screen stacking")
    # Line budget cap: probes are runtime-assertive, not a needle wall; keep compact when extending coverage.
    if "Authorization" in html_sessions or "token " in html_sessions:
        problems.append("pr-sessions.html must stay token-free")
    if problems:
        raise SystemExit("render-sai-feature-maps --check failed:\n- " + "\n- ".join(problems))

def run_selftest() -> int:
    """Adversarial rollupChecks harness in node (exact shipped JS); fail-loud without node (Saul P1)."""
    # Harness drives the exact shipped ghJson/ghWindowRoll; GH_API/ETAGS/GH_WINDOW_MS live in SESSIONS_JS.
    harness = ('const GH_API="https://api.github.com/repos/Dezocode/Sai";\nconst GH_WINDOW_MS=3600000;\nconst GH_MIN_REMAIN=5,GH_WINDOW_BUDGET=60;\nconst ETAGS={};\n'
               + ROLLUP_JS + ENRICH_JS + GH_PLANE_JS + FLIGHT_JS + SELFTEST_JS)
    with tempfile.TemporaryDirectory(prefix="sai-rollup-selftest-") as tmp:
        js = Path(tmp) / "rollup_selftest.js"
        js.write_text(harness, encoding="utf-8")
        try:
            cp = subprocess.run(["node", str(js)], text=True, capture_output=True)
        except FileNotFoundError:
            raise SystemExit("render-sai-feature-maps --selftest: node required but not on PATH")
    sys.stdout.write(cp.stdout)
    if cp.returncode != 0:
        sys.stderr.write(cp.stderr or "");raise SystemExit("render-sai-feature-maps --selftest: node harness FAILED")
    print("OK render-sai-feature-maps --selftest: rollupChecks latest-wins harness ALL PASS")
    return 0

def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    for flag, kw in (("--root", {"default": "."}), ("--out", {"default": ""}), ("--checks", {"default": ""}),
                     ("--check", {"action": "store_true"}), ("--selftest", {"action": "store_true"}),
                     ("--branch", {"default": ""}), ("--sha", {"default": ""})):
        ap.add_argument(flag, **kw)
    ns = ap.parse_args(argv)
    if ns.selftest:
        return run_selftest()
    root = Path(ns.root).resolve()
    os.chdir(root)
    feats, drift, cap = load_kernel_maps(root)
    if not feats:
        print("render-sai-feature-maps: no indexed features", file=sys.stderr);return 1
    sha = ns.sha or git(root, "rev-parse", "HEAD")
    branch = ns.branch or git(root, "rev-parse", "--abbrev-ref", "HEAD") or "HEAD"
    checks_path = Path(ns.checks) if ns.checks else None
    checks = load_checks(checks_path, root, sha)
    try:
        when = datetime.now(ZoneInfo("America/Chicago")).strftime("%d %b %Y - %I:%M %p CT")
    except Exception:when = datetime.utcnow().strftime("%d %b %Y - %H:%M UTC")
    html_text = render(root, feats, drift, cap, checks, branch, sha, when)
    html_sessions = render_sessions(branch, sha, when)
    if ns.check:
        run_selftest()
        with tempfile.TemporaryDirectory(prefix="sai-feature-maps-") as tmp:
            out = Path(tmp);write_site(out, html_text, html_sessions)
            verify(out, feats, html_text, html_sessions)
        print("OK render-sai-feature-maps --check features=%d" % len(feats));return 0
    if not ns.out:
        print("render-sai-feature-maps: --out DIR required (or --check)", file=sys.stderr)
        return 2
    out = Path(ns.out)
    if not out.is_absolute():out = root / out
    write_site(out, html_text, html_sessions)
    print("wrote %s/feature-maps.html" % out);print("wrote %s/pr-sessions.html" % out)
    return 0
if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
