# Plain (non-f-string) on purpose: real JS braces. Inserted verbatim.
SESSIONS_JS = """
const FIELDS=["profile","status","phase","head","heartbeat","steer","monitors"];
const WHEEL=document.getElementById("wheel");
const NOTE=document.getElementById("note");
const SUMMARY=document.getElementById("summary");
const STALE_MIN=30;
const esc=s=>String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","'":"&#39;"}[c]));
const dash=s=>(s==null||s===""?"\\u2014":s);
const stCls=s=>({active:"ok",finished:"ok",done:"mute",failed:"bad"}[String(s||"").toLowerCase()]||"warn");
function ageMin(iso){const t=Date.parse(iso);if(isNaN(t))return null;return Math.max(0,Math.round((Date.now()-t)/60000));}
function age(iso){const m=ageMin(iso);if(m==null)return "";return m<60?m+"m ago":Math.round(m/60)+"h ago";}
function isStale(s){const m=ageMin(s&&s.heartbeat_at);return m==null||m>=STALE_MIN;}
function cell(f,s){
  if(f==="status"){return '<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span>';}
  if(f==="steer"){const n=s.note?String(s.note):"";return n?'<span class="st warn">'+esc(n)+'</span>':'<span class="st mute">none reported</span>';}
  if(f==="heartbeat"){const a=age(s.heartbeat_at);return esc(dash(s.heartbeat_at))+(a?' <span class="dim">\\u00b7 '+esc(a)+'</span>':'');}
  if(f==="monitors"){const m=Array.isArray(s.monitors)?s.monitors.join(", "):s.monitors;return esc(dash(m));}
  return esc(dash(s[f]));
}
function srow(s){
  const m=ageMin(s&&s.heartbeat_at);
  const stale=(m==null||m>=STALE_MIN);
  const staleLabel=m==null?'stale &middot; heartbeat missing':'stale &middot; no beat for '+STALE_MIN+'m+';
  return '<div class="srow"><div class="sid"><span>'+esc(dash(s.id))+'</span>'
    +'<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span></div>'
    +'<div class="fields">'+FIELDS.map(f=>'<div class="k2">'+esc(f)+'</div><div class="v2">'+cell(f,s)+'</div>').join("")
    +(stale?'<div class="k2">heartbeat</div><div class="v2 hb-stale">'+staleLabel+'</div>':'')+'</div></div>';
}
function group(list){
  const byPr=new Map();
  for(const s of list){const k=s&&s.pr!=null?String(s.pr):"?";if(!byPr.has(k))byPr.set(k,[]);byPr.get(k).push(s);}
  const keys=[...byPr.keys()].sort((a,b)=>{const na=a==="?"?Infinity:parseInt(a,10),nb=b==="?"?Infinity:parseInt(b,10);return na-nb;});
  return keys.map(k=>{
    const ss=(byPr.get(k)||[]).slice().sort((x,y)=>String(x.id||"").localeCompare(String(y.id||"")));
    const stale=ss.some(isStale);
    return '<article class="pcard"'+(stale?' style="outline:2px solid var(--bad);outline-offset:-2px"':'')+'><h2>PR '+(k==="?"?"?":"#"+esc(k))+'</h2>'
      +'<p class="sub">'+ss.length+' session'+(ss.length===1?"":"s")+(stale?' &middot; <span class="hb-stale">stale heartbeat</span>':'')+'</p>'
      +ss.map(srow).join("")+'</article>';
  }).join("");
}
function summarize(list){
  if(SUMMARY){SUMMARY.innerHTML=summaryHTML(list);}
}
function summaryHTML(list){
  if(!Array.isArray(list)||!list.length)return "";
  const byStatus=new Map(),fresh=[],stale=[];
  for(const s of list){
    const k=String(s&&s.status?s.status:"unknown").toLowerCase();
    byStatus.set(k,(byStatus.get(k)||0)+1);
    (isStale(s)?stale:fresh).push(s);
  }
  const chips=[...byStatus.entries()].sort().map(kv=>'<span class="pill">'+esc(kv[0])+": "+kv[1]+'</span>').join(" ");
  const prCount=new Set(list.map(s=>s&&s.pr!=null?String(s.pr):"?")).size;
  return '<span class="lbl">PR GRAPH</span><span class="pill">prs: '+prCount+'</span><span class="pill">sessions: '+list.length+'</span>'
    +chips+' <span class="pill">heartbeats fresh(&lt;'+STALE_MIN+'m): '+fresh.length+'</span>'
    +'<span class="pill'+(stale.length?' hb-stale':'')+'">stale: '+stale.length+'</span>';
}
async function load(){
  try{
    const r=await fetch("__API__",{cache:"no-store"});
    if(!r.ok)throw new Error("HTTP "+r.status);
    const d=await r.json();
    const list=Array.isArray(d&&d.sessions)?d.sessions:[];
    WHEEL.innerHTML=list.length?('<div class="wheel">'+group(list)+'</div>'):'<p class="empty">No sessions reported right now.</p>';
    summarize(list);
    NOTE.textContent="count="+list.length+(d&&d.updated_at?" \u00b7 updated_at="+d.updated_at:"")+" \u00b7 live GET \u00b7 refreshes every 60s \u00b7 no secrets, nothing invented";
  }catch(e){
    WHEEL.innerHTML='<p class="empty">Sessions unavailable ('+esc(e&&e.message?e.message:String(e))+'). Nothing shown is invented.</p>';
    summarize([]);
    NOTE.textContent="unavailable";
  }
}
load();
setInterval(load,60000);
""".replace("__API__", SESSIONS_API)


def git(root: Path, *args: str) -> str:
    cp = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True)
    return cp.stdout.strip() if cp.returncode == 0 else ""


def e(text: str) -> str:
    return html.escape(text, quote=True)


def items_ul(items: list[str]) -> str:
    if not items:
        return '<p class="empty">None listed on this HEAD.</p>'
    return "<ul>" + "".join(f"<li>{e(x)}</li>" for x in items) + "</ul>"


def subs_ul(subs: list[tuple[str, str]]) -> str:
    if not subs:
        return '<p class="empty">None listed on this HEAD.</p>'
    rows = []
    for sid, rest in subs:
        extra = f" {e(rest)}" if rest else ""
        rows.append(f'<li><span class="id">{e(sid)}</span>{extra}</li>')
    return "<ul>" + "".join(rows) + "</ul>"


def feat_section(title: str, inner: str) -> str:
    return f'<section class="sec"><h2>{e(title)}</h2>{inner}</section>'


def load_kernel_maps(root: Path) -> tuple[list[dict], list[str], str]:
    cmd = ["go", "run", "./cmd/sai-verify", "maps", "--root", str(root)]
    try:
        cp = subprocess.run(cmd, cwd=root, text=True, capture_output=True)
    except FileNotFoundError as exc:
        raise SystemExit(
            "render-sai-feature-maps: go is required to consume cmd/sai-verify maps"
        ) from exc
    if cp.returncode != 0:
        err = (cp.stderr or cp.stdout or "sai-verify maps failed").strip()
        raise SystemExit("render-sai-feature-maps: " + err)
    try:
        payload = json.loads(cp.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is invalid") from exc
    if not isinstance(payload, dict):
        raise SystemExit("render-sai-feature-maps: sai-verify maps JSON is not an object")
    feats: list[dict] = []
    for raw in payload.get("features") or []:
        if not isinstance(raw, dict):
            continue
        subs: list[tuple[str, str]] = []
        for pair in raw.get("subfeatures") or []:
            if isinstance(pair, (list, tuple)) and len(pair) >= 1:
                sid = str(pair[0])
                rest = str(pair[1]) if len(pair) > 1 else ""
                subs.append((sid, rest))
        feats.append(
            {
                "id": str(raw.get("id") or ""),
                "file": str(raw.get("file") or ""),
                "title": str(raw.get("title") or ""),
                "desc": str(raw.get("desc") or ""),
                "subs": subs,
                "ents": [str(x) for x in (raw.get("entry_points") or [])],
                "proofs": [str(x) for x in (raw.get("proofs") or [])],
                "gotchas": [str(x) for x in (raw.get("gotchas") or [])],
            }
        )
    drift = [str(x) for x in (payload.get("problems") or [])]
    if drift:
        raise SystemExit("render-sai-feature-maps: invalid map: " + "; ".join(drift))
    cap = str(payload.get("caption") or "")
    return feats, drift, cap


def load_checks(path: Path | None, root: Path, sha: str) -> list[dict]:
    rows: list[dict] = []
    if path and path.is_file():
        try:
            raw = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            raw = []
        rows = raw if isinstance(raw, list) else raw.get("check_runs", [])
    else:
        repo = git(root, "config", "--get", "remote.origin.url")
        m = re.search(r"github.com[:/]([^/]+/[^/.]+)", repo)
        slug = m.group(1) if m else "Dezocode/Sai"
        stdout = ""
        try:
            cp = subprocess.run(
                ["gh", "api", f"repos/{slug}/commits/{sha}/check-runs", "--paginate"],
                text=True,
                capture_output=True,
            )
            if cp.returncode == 0:
                stdout = cp.stdout.strip()
        except (FileNotFoundError, OSError):
            stdout = ""
        if stdout:
            try:
                blob = json.loads(stdout)
            except json.JSONDecodeError:
                blob = []
            if isinstance(blob, list):
                for part in blob:
                    if isinstance(part, dict):
                        rows.extend(part.get("check_runs", []) or ([part] if part.get("name") else []))
            else:
                rows = blob.get("check_runs", [])
    latest: dict[str, dict] = {}
    for r in rows:
        name = str(r.get("name") or "").strip()
        if not name:
            continue
        latest[name] = {
            "name": name,
            "conclusion": str(r.get("conclusion") or "").lower() or "unevaluated",
            "status": str(r.get("status") or ""),
        }
    out = list(latest.values())
    have = {c["name"] for c in out}
    for name in KNOWN_CHECKS:
        if name not in have:
            out.append({"name": name, "conclusion": "unevaluated", "status": ""})
    return out


def constitution(root: Path) -> list[tuple[str, str]]:
    return [(label, rel) for label, rel in CONSTITUTION if (root / rel).exists()]


def pill_class(conclusion: str) -> str:
    if conclusion in ("failure", "failed", "timed_out", "cancelled"):
        return "bad"
    if conclusion in ("action_required", "neutral", "stale"):
        return "warn"
    if conclusion in ("success", "passed"):
        return "ok"
    return "mute"


def render(root: Path, feats: list[dict], drift: list[str], cap: str, checks: list[dict], branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    nav_feat = ['<a class="on" data-id="readme" href="#readme">README.md</a>']
    nav_feat += [f'<a data-id="{e(f["id"])}" href="#{e(f["id"])}">{e(f["file"])}</a>' for f in feats]
    cons = constitution(root)
    nav_con = [f"<span>{e(label)}</span>" for label, _ in cons]
    cards = []
    for f in feats:
        cards.append(
            f'<article class="card" id="{e(f["id"])}">'
            f'<h2 class="feat">{e(f["title"])}</h2>'
            f'<p class="desc">{e(f["desc"])}</p>'
            f'{feat_section("Sub-features", subs_ul(f["subs"]))}'
            f'{feat_section("How to get to it", items_ul(f["ents"]))}'
            f'{feat_section("Driving it", items_ul(f["proofs"]))}'
            f'{feat_section("Gotchas", items_ul(f["gotchas"]))}'
            "</article>"
        )
    banner = ""
    if drift:
        items = "".join(f"<li>{e(x)}</li>" for x in drift)
        banner = (
            '<div class="drift"><strong>Docs drift.</strong> '
            f"Map index vs siblings on this HEAD:<ul>{items}</ul></div>"
        )
    check_rows = []
    for c in checks:
        conc = c["conclusion"] or "unevaluated"
        check_rows.append(
            f'<li><span>{e(c["name"])}</span>'
            f'<span class="st {pill_class(conc)}">{e(conc)}</span></li>'
        )
    check_note = (
        "Check names from GitHub when a token is present. No secrets. "
        "Missing conclusions stay unevaluated, never success."
    )
    sdl = (
        '<div class="sdl"><div class="sdl-k">app constitution (not Origin chrome)</div>'
        "<div>canvas #0F1115</div><div>accent #5B8CFF</div>"
        "<div>foundation-draft · featureUIAllowed=false</div>"
        "<div>Sai Design Language check is PR 73-only until that merges.</div></div>"
    )
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai feature maps</title>
{BASE_CSS}</head>
<body>
<header class="top">
  <div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs">
    <a class="on" href="{GH_WEB}">Code</a>
    <a href="{GH_WEB}/pulls">Pull Requests</a>
    <a href="{GH_WEB}/settings">Settings</a>
    <a href="#readme">Preview</a>
    <a href="pr-sessions.html">PR sessions</a>
  </nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div>
  <div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a>
</header>
<div class="shell">
  <aside class="side">
    <div class="k">VERIFY-SAI / FEATURES</div>
    <nav class="nav">{''.join(nav_feat)}</nav>
    <div class="k">CONSTITUTION</div>
    <nav class="nav">{''.join(nav_con) if nav_con else '<span>none on this HEAD</span>'}</nav>
  </aside>
  <main class="main">
    <h1 id="readme">Sai feature maps</h1>
    <p class="cap">{e(cap)} Origin-styled surface, not a second constitution. Canonical parser remains <code>cmd/sai-verify</code>.</p>
    {banner}
    {''.join(cards)}
  </main>
  <aside class="right">
    <div class="k">CHECKS · EXACT HEAD</div>
    <ul class="checks">{''.join(check_rows)}</ul>
    <p class="note">{e(check_note)}</p>
    <div class="k">SAI DESIGN LANGUAGE</div>
    {sdl}
    <p class="host">GitHub Pages on Dezocode/Sai (site is public). Hostinger stays Saul-go. Drive HTML is recovery only.</p>
  </aside>
</div>
<script>
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{{
  document.querySelectorAll('.nav a').forEach(x=>x.classList.toggle('on',x===a));
}}));
</script>
</body></html>
"""


def render_sessions(branch: str, sha: str, when: str) -> str:
    short = sha[:7] if sha else "unknown"
    return f"""<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sai PR sessions</title>
{BASE_CSS}
{SESSIONS_CSS}</head>
<body>
<header class="top">
  <div class="crumb">Dezocode <span>/</span> Sai</div>
  <nav class="tabs">
    <a href="{GH_WEB}">Code</a>
    <a href="index.html">Feature maps</a>
    <a class="on" href="pr-sessions.html">PR sessions</a>
    <a href="{GH_WEB}/pulls">Pull Requests</a>
  </nav>
  <div class="meta"><span class="pill">{e(branch)}</span><span class="pill">{e(short)}</span></div>
  <div class="when">{e(when)}</div>
  <a class="btn" href="{GH_WEB}">Code</a>
</header>
<main class="main">
  <h1 id="readme">PR sessions</h1>
  <p class="cap">Hermes agent sessions driving Dezocode/Sai pull requests, one card per PR in a horizontally scrollable wheel. Live read-only GET from the sessions API below; every field comes straight from the response and stays blank or marked unavailable when missing. No secrets, no tokens, nothing invented.</p>
  <div class="psummary" id="summary" aria-live="polite"></div>
  <div class="wheelwrap" id="wheelwrap">
    <div class="wheel" id="wheel"><noscript><p class="empty">JavaScript disabled — live sessions cannot load.</p></noscript></div>
  </div>
  <p class="note" id="note">loading…</p>
  <p class="host">Source: <code>{e(SESSIONS_API)}</code>. Generated at exact HEAD; the wheel fills in live in your browser. Hostinger stays Saul-go.</p>
</main>
<script>{SESSIONS_JS}</script>
</body></html>
"""


def write_site(out: Path, html_text: str, html_sessions: str) -> None:
    out.mkdir(parents=True, exist_ok=True)
    (out / "feature-maps.html").write_text(html_text, encoding="utf-8")
    (out / "index.html").write_text(html_text, encoding="utf-8")
    (out / "pr-sessions.html").write_text(html_sessions, encoding="utf-8")
    (out / ".nojekyll").write_text("", encoding="utf-8")


def verify(out: Path, feats: list[dict], html_text: str, html_sessions: str) -> None:
    problems: list[str] = []
    if not (out / ".nojekyll").is_file():
        problems.append("missing .nojekyll")
    if "#f8f8f8" not in html_text or "#34785c" not in html_text:
        problems.append("missing Origin chrome tokens")
    if "body{margin:0;background:var(--bg)" not in html_text:
        problems.append("body is not Origin canvas")
    if "Hostinger stays Saul-go" not in html_text:
        problems.append("missing Hostinger boundary")
    for heading in ("Sub-features", "How to get to it", "Driving it", "Gotchas"):
        if f"<h2>{heading}</h2>" not in html_text:
            problems.append("missing four-H2 heading " + heading)
    for f in feats:
        if f["title"] not in html_text:
            problems.append("missing title " + f["title"])
        if not f["subs"]:
            problems.append(f["id"] + " has no sub-features")
        for sid, rest in f["subs"]:
            if sid not in html_text:
                problems.append("missing sub-id " + sid)
            if rest and e(rest) not in html_text:
                problems.append("missing sub-rest " + sid)
        for kind, rows in (("ents", f["ents"]), ("proofs", f["proofs"]), ("gotchas", f["gotchas"])):
            for row in rows:
                if e(row) not in html_text:
                    problems.append("missing " + kind + " text in " + f["id"])
                    break
    if 'href="pr-sessions.html"' not in html_text:
        problems.append("feature-maps.html missing PR sessions tab link")
    if not (out / "pr-sessions.html").is_file():
        problems.append("missing pr-sessions.html")
    if len(html_sessions) < 200:
        problems.append("pr-sessions.html suspiciously small")
    sessions_needles = (
        SESSIONS_API,
        "overflow-x:auto",
        'id="wheel"',
        'id="summary"',
        "setInterval(load,60000)",
        'FIELDS=["profile","status","phase","head","heartbeat","steer","monitors"]',
        ".hb-stale",
        "<noscript>",
        "Hostinger stays Saul-go",
    )
    for needle in sessions_needles:
        if needle not in html_sessions:
            problems.append("pr-sessions.html missing " + needle)
    # Token names are legitimate prose inside the protected-ci feature map;
    # the enforcement point is the workflow env (renderer runs with tokens
    # unset), not output text. The sessions page we author here must never
    # reference tokens at all.
    if "X-Sessions-Token" in html_text:
        problems.append("feature-maps.html contains forbidden X-Sessions-Token")
    for banned in ("X-Sessions-Token", "GH_TOKEN", "GITHUB_TOKEN"):
        if banned in html_sessions:
            problems.append("pr-sessions.html contains forbidden " + banned)
    if problems:
        raise SystemExit("render-sai-feature-maps --check failed:\n- " + "\n- ".join(problems))


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", default=".")
    ap.add_argument("--out", default="")
    ap.add_argument("--checks", default="")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--branch", default="")
    ap.add_argument("--sha", default="")
    ns = ap.parse_args(argv)
    root = Path(ns.root).resolve()
    os.chdir(root)
    feats, drift, cap = load_kernel_maps(root)
    if not feats:
        print("render-sai-feature-maps: no indexed features", file=sys.stderr)
        return 1
    sha = ns.sha or git(root, "rev-parse", "HEAD")
    branch = ns.branch or git(root, "rev-parse", "--abbrev-ref", "HEAD") or "HEAD"
    checks_path = Path(ns.checks) if ns.checks else None
    checks = load_checks(checks_path, root, sha)
    try:
        from zoneinfo import ZoneInfo

        when = datetime.now(ZoneInfo("America/Chicago")).strftime("%d %b %Y - %I:%M %p CT")
    except Exception:
        when = datetime.utcnow().strftime("%d %b %Y - %H:%M UTC")
    html_text = render(root, feats, drift, cap, checks, branch, sha, when)
    html_sessions = render_sessions(branch, sha, when)
    if ns.check:
        with tempfile.TemporaryDirectory(prefix="sai-feature-maps-") as tmp:
            out = Path(tmp)
            write_site(out, html_text, html_sessions)
            verify(out, feats, html_text, html_sessions)
        print("OK render-sai-feature-maps --check features=%d" % len(feats))
        return 0
    if not ns.out:
        print("render-sai-feature-maps: --out DIR required (or --check)", file=sys.stderr)
        return 2
    out = Path(ns.out)
    if not out.is_absolute():
        out = root / out
    write_site(out, html_text, html_sessions)
    print("wrote %s/feature-maps.html" % out)
    print("wrote %s/pr-sessions.html" % out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
