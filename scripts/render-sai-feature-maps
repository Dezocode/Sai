FLIGHT_JS = """
const FESC_MAP={"&":"&amp;","<":"&lt;",">":"&gt;",[String.fromCharCode(34)]:"&quot;",[String.fromCharCode(39)]:"&#39;"};
const fEsc=s=>String(s==null?"":s).replace(/[&<>"']/g,c=>FESC_MAP[c]); // FLIGHT-BOARD is self-contained: no SESSIONS_JS esc dependency.
function pctOf(x){ // FLIGHT-BOARD: strict numeric 0..100; anything else renders unavailable, never coerced to 0.
  return (typeof x==="number"&&isFinite(x)&&x>=0&&x<=100)?Math.round(x):null;
}
function verifierGated(p){ // flat /sessions progress counts only when its source names a known verifier/aggregator identity (no agent self-award).
  const s=p&&typeof p==="object"?String(p.source||"").toLowerCase():"";
  return /^(pr[-_])?aggregator$|^sai-verify/.test(s);
}
function flightBreakdown(f){ // "Goals X/45 · CI X/20 · Saul X/20 · Preservation X/10 · Hygiene X/5" (+ requirement states when present).
  if(!f||typeof f!=="object")return "unavailable";
  const mc=f.merge_components&&typeof f.merge_components==="object"?f.merge_components:null;
  if(!mc)return "unavailable";
  const n=(o,k)=>o&&Number.isFinite(Number(o[k]))?Number(o[k]):null;
  const g=n(mc,"goals"),ci=n(mc,"ci"),sl=n(mc,"saul"),pr=n(mc,"preservation"),hy=n(mc,"hygiene");
  if(g==null||ci==null||sl==null||pr==null||hy==null)return "unavailable"; // partial component sets are not invented into totals.
  let t="Goals "+g+"/45 · CI "+ci+"/20 · Saul "+sl+"/20 · Preservation "+pr+"/10 · Hygiene "+hy+"/5";
  const rq=f.requirements&&typeof f.requirements==="object"?f.requirements:null;
  if(rq){
    const r=["met","partial","unmet","blocked"].map(k=>k+" "+(Number.isFinite(Number(rq[k]))?Number(rq[k]):"unavailable"));
    t+=" — requirements: "+r.join(" · ");
  }
  return t;
}
function shortShaF(x){x=String(x||"");return x.length>=7?x.slice(0,7):x;}
function flightBars(f,headSha){ // Two rows: visible label + track + numeric % OUTSIDE the bar so narrow layouts never truncate either.
  const bad=!f||typeof f!=="object"||f.status==="unavailable";
  const head=String(headSha||"");
  const bound=(!bad&&f.head_sha)?String(f.head_sha):"";
  const cur=bound&&head&&head.toLowerCase().startsWith(bound.toLowerCase()); // SHA-bound freshness: mismatch renders stale, never current.
  const st=(bound&&!cur)?" <span class='mismatch' title='bound "+fEsc(bound.slice(0,12))+" @ "+fEsc(f.computed_at||"unknown time")+"'>@"+fEsc(shortShaF(bound))+" stale</span>":"";
  const imp=bad?null:pctOf(f.implementation_pct);
  const mr=bad?null:pctOf(f.merge_readiness_pct);
  const row=(label,pct)=>"<div class='fbar'><span class='flbl'>"+label+"</span>"
    +"<span class='ftrack' role='img' aria-label='"+label+(pct==null?" unavailable":": "+pct+" percent")+"'>"
    +"<span class='ffill"+(pct==null?" none":"")+"' style='"+(pct==null?"width:0":"width:"+pct+"%")+"'></span></span>"
    +"<span class='fpct'>"+(pct==null?"<span class='dim'>unavailable</span>":pct+"%")+st+"</span></div>";
  return row("Implementation",imp)+row("Merge readiness",mr);
}
