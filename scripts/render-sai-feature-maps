#!/usr/bin/env python3
"""Render Origin-light feature-maps.html from HEAD verify-sai maps.

Consumes `go run ./cmd/sai-verify maps` JSON. Does not parse README index
or four-H2 Markdown. HTML is generated output, never the source of truth.

Also emits pr-sessions.html: a scrollable PR wheel joining two live data
planes by PR number - authoritative GitHub PR state for Dezocode/Sai via
the unauthenticated public REST API (CORS-enabled; ETag conditional GETs;
never any token), and Hermes agent sessions from the public sessions API.
PR cards are the union of both planes; open PRs with no session show an
Agent NONE card; session HEAD is compared against authoritative PR HEAD.
The renderer never receives or embeds tokens; missing data renders as
unavailable, never fabricated.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

