#!/usr/bin/env python3
"""Render Origin-light feature-maps.html from HEAD verify-sai maps.

Consumes `go run ./cmd/sai-verify maps` JSON. Does not parse README index
or four-H2 Markdown. HTML is generated output, never the source of truth.

Also emits pr-sessions.html: a scrollable PR wheel of live Hermes agent
sessions, fetched client-side from the public sessions API. The renderer
never receives or embeds tokens; missing session data renders as
unavailable, never fabricated.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

CONSTITUTION = (
    ("architecture.md", ".ai/shared/memory/architecture.md"),
    ("AGENTS.md", "AGENTS.md"),
    ("testing.md", ".ai/shared/references/testing.md"),
    ("icm-ci-policy.md", ".ai/shared/references/icm-ci-policy.md"),
    ("sai-design-language.json", "sai-design-language.json"),
)
KNOWN_CHECKS = (
    "icm-enforcement",
    "Anti-regression",
    "PR line budget",
    "Saul / Product Quality",
)
SESSIONS_API = "https://srv1840454.hstgr.cloud/api/hermes-sessions/sessions"
GH_WEB = "https://github.com/Dezocode/Sai"

BASE_CSS = """<style>
:root{--bg:#f8f8f8;--side:#f3f3f3;--ink:#141414;--mute:#6b6b6b;--line:#e6e6e6;--card:#fff;--accent:#34785c;--warn:#c9a227;--bad:#c45c4a;--ok:#3d8f6b;--sdl:#0F1115;--sdla:#5B8CFF}
