function flightBlock(c){ // FLIGHT-BOARD: always-rendered section; honest unavailable when the API carries no authority.
  const f=(FLIGHT[c.k]&&typeof FLIGHT[c.k]==="object")?FLIGHT[c.k]:{};
  const head=c.pr&&c.pr.headSha?c.pr.headSha:"";
  const src=(f&&typeof f.source==="string"&&f.source)?f.source:"unavailable";
  return '<div class="srow"><div class="sid"><span>Flight board</span><span class="pill">'+esc(src)+"</span></div>"
    +flightBars(f,head)+'<details class="fbrk"><summary>merge components</summary><div class="v2">'+esc(flightBreakdown(f))+"</div></details></div>";
}

function ageMin(iso){const t=Date.parse(iso);if(isNaN(t))return null;return Math.max(0,Math.round((Date.now()-t)/60000));}
function age(iso){const m=ageMin(iso);if(m==null)return "";return m<60?m+"m ago":Math.round(m/60)+"h ago";}
function beatBucket(s){const m=ageMin(s&&s.heartbeat_at);return m==null?"missing":(m<STALE_MIN?"fresh":"stale");}
function isStale(s){return beatBucket(s)==="stale";}
function isMissing(s){return beatBucket(s)==="missing";}
function shortSha(x){x=String(x||"");return x.length>=7?x.slice(0,7):x;}
async function loadPulls(){
  try{
    const j=await ghJson("/pulls?state=all&per_page=100&sort=created&direction=desc","pulls");
    if(j.notModified)return;
    if(!Array.isArray(j.data))throw new Error("malformed GitHub pull-list payload");
    const map=new Map();for(const p of j.data){if(p&&p.number!=null)map.set(String(p.number),p);}
    PULLS=map;PULLS_ERR="";
  }catch(err){PULLS_ERR=err&&err.message?err.message:String(err);}
}
async function refreshDetail(num){
  try{
    const j=await ghJson("/pulls/"+num,"pr:"+num);
    if(j.notModified){DETAIL_TS[num]=Date.now();return;}
    const d=j.data||{};
    DETAIL[num]={title:d.title||"",state:d.state||"",draft:!!d.draft,mergedAt:d.merged_at||"",
      mergeable:d.mergeable,mergeableState:d.mergeable_state||"",headSha:d.head&&d.head.sha?d.head.sha:"",
      pushedAt:d.head&&d.head.repo&&d.head.repo.pushed_at||"",updatedAt:d.updated_at||""};
    DETAIL_TS[num]=Date.now();DETAIL_FAIL[num]=0;delete DETAIL_RETRY_AT[num];
  }catch(err){
    DETAIL_FAIL[num]=(DETAIL_FAIL[num]||0)+1;
    DETAIL_RETRY_AT[num]=Date.now()+DETAIL_RETRY_MS;
    if(DETAIL[num]===undefined)DETAIL[num]=null;
  }
}
__ROLLUP__
async function refreshChecks(num){ // Round-8: listing HEAD wins over cached detail so force-pushes re-bind.
  const pr=PULLS?PULLS.get(String(num)):undefined;
  let sha=pr&&pr.head&&pr.head.sha?String(pr.head.sha).toLowerCase():"";
  if(!sha){const det=DETAIL[num];sha=det&&det.headSha?String(det.headSha).toLowerCase():"";}
  if(!sha)return;
  try{
    const f=await fetchAllChecks(sha);
    if(!f.runs)return;
    const r=rollupChecks(f.runs);
    CHECKS[sha]={total:r.total,fails:r.fails,pending:r.pending,saul:saulLabel(r.saul),partial:f.partial};
  }catch(err){if(CHECKS[sha]===undefined)CHECKS[sha]=null;}
}
function pcounts(text){
  if(!text)return null;
  const grab=(tag)=>{
    const i=text.indexOf(tag);if(i<0)return null;
    let j=i+tag.length,num="";
    while(j<text.length&&text[j]>="0"&&text[j]<="9"){num+=text[j];j++;}
    return num===""?null:num;
  };
  const p0=grab("P0="),p1=grab("P1="),p2=grab("P2=");
  return (p0==null||p1==null||p2==null)?null:{p0:p0,p1:p1,p2:p2};
}
function saulLabel(c){
  if(!c)return "";
  const pc=pcounts(c.output&&c.output.summary);
  if(pc)return "P0="+pc.p0+" P1="+pc.p1+" P2="+pc.p2;
  const cc=String(c.conclusion||"");
  return cc==="success"?"success (no blocking findings)":(cc||"unknown");
}
function normalize(k){
  const raw=PULLS?PULLS.get(k):undefined;
  const det=DETAIL[k];
  if(!raw&&det===undefined)return null;
  // Round-8: listing HEAD wins over cached detail so force-pushes surface.
  return {number:k,
    title:(det&&det.title)||(raw&&raw.title)||"",
    state:raw?String(raw.state):(det&&det.state?det.state:"unknown"),
    draft:raw?!!raw.draft:(det?!!det.draft:false),
    merged:raw?!!raw.merged_at:(det?!!det.mergedAt:false),
    headSha:(raw&&raw.head&&raw.head.sha)||(det&&det.headSha)||"",
    pushedAt:(det&&det.pushedAt)||(raw&&raw.head&&raw.head.repo&&raw.head.repo.pushed_at)||"",
    updatedAt:(det&&det.updatedAt)||(raw&&raw.updated_at)||"",
    mergeable:det?det.mergeable:undefined,mergeableState:det?det.mergeableState:""};
}
function assemble(list){
  const byPr=new Map();
  for(const s of list){const k=s&&s.pr!=null?String(s.pr):"?";if(!byPr.has(k))byPr.set(k,[]);byPr.get(k).push(s);}
  // DETAIL is enrichment-only: never union its keys (ghost-card guard).
  const keys=new Set(byPr.keys());if(PULLS)for(const k of PULLS.keys())keys.add(k);
  const arr=Array.from(keys);
  arr.sort((a,b)=>((b==="?"?-1:parseInt(b,10))-(a==="?"?-1:parseInt(a,10))));
  return arr.map(k=>{
    const ss=(byPr.get(k)||[]).slice().sort((x,y)=>String(x.id||"").localeCompare(String(y.id||"")));
    const pr=normalize(k);
    const mismatch=!!(pr&&pr.headSha&&ss.length&&ss.some(s=>{const h=String(s&&s.head||"").toLowerCase();return !!h&&!pr.headSha.toLowerCase().startsWith(h);}));
    const agentState=ss.length===0?(SESSIONS_OK?"none":"unknown"):(ss.some(isMissing)?"missing":(ss.some(isStale)?"stale":"fresh"));
    return {k:k,pr:pr,ss:ss,mismatch:mismatch,agentState:agentState};
  });
}
function cell(f,s){
  if(f==="status")return '<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span>';
  if(f==="steer"){const n=s.note?String(s.note):"";return n?'<span class="st warn">'+esc(n)+'</span>':'<span class="st mute">none reported</span>';}
  if(f==="heartbeat"){
    const b=beatBucket(s);const a=age(s.heartbeat_at);
    const cls=b==="fresh"?"hb-fresh":(b==="stale"?"hb-stale":"hb-missing"),label=b==="fresh"?("fresh"+(a?" · "+a:"")):(b==="stale"?("stale · last beat "+(a||"of unknown age")):"missing · never reported");
    return '<span class="'+cls+'" title="'+esc(s.heartbeat_at||"")+'">'+label+'</span>';
  }
  if(f==="monitors"){const m=Array.isArray(s.monitors)?s.monitors.join(", "):s.monitors;return esc(dash(m));}
  if(f==="usage")return usageView(s);if(f==="diff")return diffView(s&&s.diff);
  return esc(dash(s[f]));
}
function usageView(s){ // Round-16: live usage stats; null degrades honestly.
  const txt=usageStats(s&&s.usage);
  if(!txt)return '<span class="st mute">unavailable</span>';
  const la=age(s.usage.last_activity);
  return '<span title="'+esc(s.usage.last_activity||"")+'">'+esc(txt)+(la?" · active "+esc(la):"")+'</span>';
}
function diffView(d){ // Round-16: live worktree diff; expandable when a file list exists.
  const st=diffStats(d);
  if(!st)return '<span class="st mute">unavailable</span>';
  const badge=(st.dirty===null?"":(st.dirty?' <span class="st warn">dirty</span>':' <span class="st ok">clean</span>'));
  const list=st.files.length?"<details><summary>files</summary><ul>"+st.files.map(x=>"<li>"+esc(x)+"</li>").join("")+"</ul></details>":"";
  return "<span>"+esc(st.stat)+badge+"</span>"+list;
}
function srow(s){
  const extra=(tagsView(s)+reviewView(s));
  return '<div class="srow"><div class="sid"><span>'+esc(dash(s.id))+'</span>'
    +'<span class="st '+stCls(s.status)+'">'+esc(dash(s.status))+'</span></div>'+(extra?'<div class="atags">'+extra+"</div>":"")
    +'<div class="fields">'+FIELDS.map(f=>'<div class="k2">'+esc(f)+'</div><div class="v2">'+cell(f,s)+'</div>').join("")+'</div></div>';
}
function stateBadge(pr){
  const label=pr.merged?"merged":(pr.state||"unknown");
  const cls=pr.merged?"mute":(pr.state==="open"?"ok":"mute");
  return '<span class="st '+cls+'">'+esc(label)+"</span>";
}
function reviewBadge(pr){
  if(pr.merged||pr.state!=="open")return "—";
  return '<span class="st '+(pr.draft?"warn":"ok")+'">'+esc(pr.draft?"draft":"ready")+"</span>";
}
function mergeView(pr){
  if(pr.mergeable===true)return pr.mergeableState&&pr.mergeableState!=="clean"?("mergeable · "+esc(pr.mergeableState)):"mergeable";
  if(pr.mergeable===false)return pr.mergeableState?("state: "+esc(pr.mergeableState)):"merge conflicts";
  if(pr.mergeableState)return "state: "+esc(pr.mergeableState);
  if(pr.state!=="open")return "—";
  return "unavailable";
}
function pushView(pr){
  const t=pr.pushedAt;
  if(!t)return "unavailable";
  return '<span title="activity on the head repo, not the PR head commit">'+esc(age(t)||String(t).slice(0,10))+'</span>';
}
function updateView(pr){
  const t=pr.updatedAt;
  if(!t)return "unavailable";
  return esc(age(t)||String(t).slice(0,10));
}
function checksFor(pr){
  // Round-8: normalize() prefers listing HEAD, so force-pushes re-bind CHECKS.
  if(!pr||!pr.headSha)return undefined;
  return CHECKS[String(pr.headSha).toLowerCase()];
}
function ciView(pr,c){
  // Round-8 honesty: out-of-scope cards read unavailable, never "loading…".
  const ck=checksFor(pr);
  const live=(c&&c.ss&&c.ss.length)>0||(pr.state==="open"&&!pr.merged);
  if(!pr.headSha)return "unavailable";
  if(ck===undefined)return live?"loading…":"unavailable";
  if(ck===null)return "unavailable";
  if(!ck.total)return "no check runs"; // "partial" = pagination cap hit; may be missing runs, never claimed whole.
  return esc(ck.total+" checks"+(ck.fails?" · "+ck.fails+" failed":"")+(ck.pending?" · "+ck.pending+" running":"")+(ck.partial?" · partial":""));
}
function saulView(pr,c){
  const ck=checksFor(pr);
  const live=(c&&c.ss&&c.ss.length)>0||(pr.state==="open"&&!pr.merged);
  if(!pr.headSha)return "unavailable";
  if(ck===undefined)return live?"loading…":"unavailable";
  if(ck===null)return "unavailable";
  if(!ck.total)return "absent";
  return esc(ck.saul||"absent");
}
function ghBody(c){
  const pr=c.pr;
  if(!pr)return '<p class="empty">GitHub PR data unavailable.</p>';
  const rows=[["title",esc(pr.title||"—")],["state",stateBadge(pr)],["review",reviewBadge(pr)],
    ["PR head",esc(pr.headSha?shortSha(pr.headSha):"—")],["CI",ciView(pr,c)],
    ["Saul / Product Quality",saulView(pr,c)],["mergeability",mergeView(pr)],
    ["head repo push",pushView(pr)],["updated",updateView(pr)]];
  if(c.mismatch)rows.push(["worker HEAD",'<span class="mismatch">session HEAD ≠ PR HEAD — worker may be behind or ahead</span>']);
  return '<div class="fields">'+rows.map(r=>'<div class="k2">'+esc(r[0])+'</div><div class="v2">'+r[1]+'</div>').join("")+'</div>';
}
function prCard(c){
  const link='<a href="'+GH_PULL+encodeURIComponent(c.k)+'">'+(c.k==="?"?"PR ?":"PR #"+esc(c.k))+"</a>";
  const titleHtml=c.pr&&c.pr.title?" — "+esc(c.pr.title):"";
  let sub;
  if(c.agentState==="none"){
    sub='<p class="sub"><span class="noworker">Agent: NONE — no worker attached</span></p>';
  }else if(c.agentState==="unknown"){
    sub='<p class="sub"><span class="st warn">Agent: UNKNOWN — sessions unavailable; worker attachment unknown</span></p>';
  }else{
    const b={fresh:0,stale:0,missing:0};
    for(const s of c.ss)b[beatBucket(s)]++;
    sub='<p class="sub">'+c.ss.length+" session"+(c.ss.length===1?"":"s")
      +' · <span class="hb-fresh">'+b.fresh+" fresh</span>"+' · <span class="hb-stale">'+b.stale+" stale</span>"
      +' · <span class="hb-missing">'+b.missing+" missing</span>"+(c.mismatch?' · <span class="mismatch">session HEAD ≠ PR HEAD</span>':"")+"</p>";
  }
  let cardCls="pcard";
  if(c.agentState==="missing")cardCls+=" hb-missing-card";else if(c.agentState==="stale")cardCls+=" hb-stale-card";
  const ghSid='<div class="sid"><span>GitHub authority</span><span class="pill">Dezocode/Sai</span></div>';
  return '<article class="'+cardCls+'"><h2>'+link+titleHtml+"</h2>"+sub+flightBlock(c)+c.ss.map(srow).join("")
    +'<div class="srow">'+ghSid+ghBody(c)+"</div></article>";
}
function group(cards){return cards.map(prCard).join("");}
function summaryHTML(cards,list){
  let open=0,openDraft=0,mergedN=0,closedN=0,sessionOnly=0,unknownKey=0,noneWorker=0,unknownWorker=0,mismatchN=0;
  for(const c of cards){
    if(c.k==="?"){unknownKey++;continue;}
    if(!c.pr){sessionOnly++;continue;}
    if(c.pr.merged)mergedN++;
    else if(c.pr.state==="open"){open++;if(c.pr.draft)openDraft++;}
    else closedN++;
    if(c.agentState==="none")noneWorker++;
    if(c.agentState==="unknown")unknownWorker++;
    if(c.mismatch)mismatchN++;
  }
  const hb={fresh:0,stale:0,missing:0};
  for(const s of list)hb[beatBucket(s)]++;
  const chips=['<span class="lbl">PR GRAPH</span>','<span class="pill">cards: '+cards.length+'</span>',
    '<span class="pill">sessions: '+list.length+'</span>','<span class="pill">open: '+open+(openDraft?" ("+openDraft+" draft)":"")+'</span>',
    '<span class="pill">merged: '+mergedN+'</span>','<span class="pill">closed: '+closedN+'</span>',
    '<span class="pill">agent NONE: '+noneWorker+'</span>'];
  if(sessionOnly)chips.push('<span class="pill">session-only PRs: '+sessionOnly+'</span>');
  if(unknownKey)chips.push('<span class="pill">unmapped PR keys: '+unknownKey+'</span>')
  if(unknownWorker)chips.push('<span class="pill hb-stale">agent unknown: '+unknownWorker+'</span>')
  if(mismatchN)chips.push('<span class="pill hb-stale">HEAD mismatch: '+mismatchN+'</span>')
  chips.push('<span class="pill">heartbeats fresh(&lt;'+STALE_MIN+'m): '+hb.fresh+'</span>',
    '<span class="pill'+(hb.stale?" hb-stale":"")+'">stale: '+hb.stale+'</span>','<span class="pill'+(hb.missing?" hb-missing":"")+'">missing: '+hb.missing+'</span>');
  return chips.join(" ");
}
function describeGh(){
  if(PULLS_ERR&&!PULLS)return "unavailable ("+PULLS_ERR+")";if(PULLS_ERR)return "partial ("+PULLS_ERR+")";
  if(PULLS)return PULLS.size+" PRs via public REST";
  return "unavailable";
}
function renderWheel(cards,list){
  if(cards.length){WHEEL.innerHTML='<div class="wheel">'+group(cards)+"</div>";return;}
  if(list.length){WHEEL.innerHTML='<p class="empty">No PR cards could be assembled; sessions exist but GitHub data is unavailable. Nothing shown is invented.</p>';return;}
  WHEEL.innerHTML='<p class="empty">No PRs and no sessions reported right now.</p>';
}
