GH_PLANE_JS = """
let GH_LAST_POLL=0,GH_REMAIN=null,GH_RESET_AT=0,GH_WINDOW_USED=0,GH_WINDOW_AT=0;
// Round-16 (Saul 97231269873): an expired X-RateLimit-Reset is consumed ONCE - rolled, re-anchored, cleared - so later headerless responses can never re-zero the local window.
function ghWindowRoll(ghNow){
  if(GH_WINDOW_AT===0)GH_WINDOW_AT=ghNow;
  if(GH_RESET_AT>0&&ghNow>=GH_RESET_AT){GH_RESET_AT=0;GH_WINDOW_USED=0;GH_WINDOW_AT=ghNow;} // expired reset consumed once
  else if(ghNow-GH_WINDOW_AT>=GH_WINDOW_MS){GH_WINDOW_AT=ghNow;GH_WINDOW_USED=0;}
}
function ghJson(path,key){
  const headers={"Accept":"application/vnd.github+json"};
  if(ETAGS[key])headers["If-None-Match"]=ETAGS[key];
  const ghNow=Date.now();ghWindowRoll(ghNow);GH_WINDOW_USED++;
  return fetch(GH_API+path,{cache:"no-store",headers:headers}).then(r=>{ // Round-13: honor rate headers so the plane backs off.
    const rem=r.headers.get("X-RateLimit-Remaining");if(rem!=null)GH_REMAIN=Number(rem);
    const rs=r.headers.get("X-RateLimit-Reset");if(rs!=null)GH_RESET_AT=Number(rs)*1000;
    if(r.status===304)return {notModified:true};
    const et=r.headers.get("ETag");if(et)ETAGS[key]=et;
    if(!r.ok)throw new Error("HTTP "+r.status+" for "+path);
    return r.json().then(j=>({data:j}));
  });
}
const CHECK_PAGES_MAX=3,PAGE_CACHE={}; // Round-17b: last-known {list,total} per (sha,page); a page 304 rebuilds the aggregate from these.
async function fetchAllChecks(sha){ // Round-17b (Saul 97267214495): page 304 reuses its cached page; every request re-passes ghStepDue.
  const runs=[];let maxTot=NaN;
  for(let p=1;p<=CHECK_PAGES_MAX;p++){
    if(p>1&&!ghStepDue(Date.now(),GH_REMAIN,GH_RESET_AT,GH_MIN_REMAIN,GH_WINDOW_USED,GH_WINDOW_BUDGET,GH_WINDOW_AT,GH_WINDOW_MS))break; // P1: pagination obeys the per-request gate.
    const key="ck:"+sha+":"+p,j=await ghJson("/commits/"+sha+"/check-runs?per_page=100&page="+p,key);let tot;
    if(j.notModified){const c=PAGE_CACHE[key];if(!c)return {runs:null,partial:false};runs.push(...c.list);tot=c.total;} // no cache: honest aggregate-level not-modified
    else{
      const batch=(j.data&&j.data.check_runs)||[];tot=j.data?Number(j.data.total_count):NaN;
      PAGE_CACHE[key]={list:batch,total:tot};runs.push(...batch);
    }
    if(Number.isFinite(tot)&&!(maxTot>=tot))maxTot=tot; // largest total seen governs completeness; a stale smaller cache total can never fabricate it.
    if(runs.length>=maxTot)return {runs:runs,partial:false};
  }
  return {runs:runs,partial:true};
}
