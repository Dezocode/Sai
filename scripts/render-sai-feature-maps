ROLLUP_JS = """
function rollupChecks(runs){ // Newest attempt per check name wins: a green rerun clears an earlier failure.
  const newest=new Map();
  const rank=x=>{if(!x)return null;
    const id=Number(x.id);if(Number.isFinite(id)&&id>0)return [2,id];
    const at=Number(x.attempt);if(Number.isFinite(at)&&at>0)return [1,at];
    return String(x.started_at||x.completed_at||"")?[0,String(x.started_at||x.completed_at||"")]:null;};
  const cmp=(a,b)=>{if(a===null)return b===null?0:-1;if(b===null)return 1;
    for(let i=0;i<2;i++){if(a[i]!==b[i])return a[i]<b[i]?-1:1;}return 0;};
  for(const c of runs){
    if(!c||!c.name)continue;
    const name=String(c.name);
    const cur=newest.get(name);
    // Newest by stable monotone order, never timestamps alone (Saul P1).
    if(!cur||cmp(rank(c),rank(cur))>0)newest.set(name,c);
  }
  let total=0,fails=0,pending=0,saul=null;
  for(const c of newest.values()){
    total++;
    if(c.status&&c.status!=="completed"){pending++;continue;}
    const cc=String(c.conclusion||"").toLowerCase();
    if(cc==="failure"||cc==="timed_out"||cc==="action_required")fails++;
    if(/saul/i.test(String(c.name))){
      const t=String(c.completed_at||"");
      if(!saul||t>=String(saul.completed_at||""))saul=c;
    }
  }
  return {total:total,fails:fails,pending:pending,saul:saul};
}
"""
