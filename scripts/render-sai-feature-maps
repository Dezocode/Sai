ENRICH_JS = """
function enrichPrio(c){
  if(c.ss&&c.ss.length)return 0;if(c.pr&&c.pr.state==="open"&&!c.pr.merged)return 1;return 2;
}
function planEnrich(cards,budget){
  const steps=[];const checked=new Set();let b=budget;const now=Date.now();
  for(const c of cards.filter(c=>c.k!=="?").sort((a,b)=>enrichPrio(a)-enrichPrio(b))){
    if(b<=0)break;
    const pr=c.pr;
    if(!(c.ss&&c.ss.length)&&!(pr&&pr.state==="open"&&!pr.merged))continue;
    const det=DETAIL[c.k];
    const ls=pr&&pr.headSha?String(pr.headSha).toLowerCase():"";
    const cs=det&&det.headSha?String(det.headSha).toLowerCase():"";
    const sha=ls||cs;
    // P1-1: session-only cards revalidate detail on a TTL once fetched. Round-12: cap = backoff (Saul 97194598684).
    const inPulls=!!(PULLS&&PULLS.get(String(c.k))),dts=DETAIL_TS[c.k];
    const stale=!inPulls&&det&&dts&&(now-dts)>REVALIDATE_MS;
    if(sha&&ENRICHED.has(sha)&&!stale)continue;
    const failed=(DETAIL_FAIL[c.k]||0)>=MAX_DETAIL_FAILS;
    const probe=!!DETAIL_RETRY_AT[c.k]&&now>=DETAIL_RETRY_AT[c.k];
    if(!det||det===null||(ls&&cs&&ls!==cs)||stale){
      if(!failed||probe){b--;steps.push({kind:"detail",k:c.k});if(b<=0)break;}
    }
    if(sha&&!checked.has(sha)){checked.add(sha);if(b>0){b--;steps.push({kind:"checks",k:c.k});}}
  }
  return steps;
}
function doneShas(cards){ // Same SHA resolution as planEnrich; DONE = check-runs fetched for that HEAD.
  const out=[];
  for(const c of cards){
    const det=DETAIL[c.k];
    const ls=c.pr&&c.pr.headSha?String(c.pr.headSha).toLowerCase():"";
    const cs=det&&det.headSha?String(det.headSha).toLowerCase():"";
    const sha=ls||cs;if(sha&&CHECKS[sha]!==undefined)out.push(sha);
  }
  return out;
}
function ghDue(now,lastPoll,remain,resetAt,pollMs,minRem){ // Round-13 (Saul 97206101278): cadence <=pollMs; hold until reset below floor.
  if(remain!=null&&now<resetAt&&(remain<=0||remain<minRem))return false;
  return now-lastPoll>=pollMs;
}
function ghStepDue(now,remain,resetAt,minRem,windowUsed,windowBudget,windowAt,windowMs){ // Round-15: floor + per-window budget anchored by windowAt.
  if(remain!=null&&now<resetAt&&remain<minRem)return false;
  return !(windowUsed>=windowBudget&&!(resetAt>0&&now>=resetAt)&&!(windowAt>0&&now-windowAt>=windowMs));
}
function posNum(x){const v=Number(x);return Number.isFinite(v)&&v>=0?v:null;}
function fmtTok(v){return v>=1000000?(Math.round(v/100000)/10)+"M":(v>=1000?(Math.round(v/100)/10)+"k":String(v));}
function usageStats(u){ // Round-16: live usage; any missing/negative piece drops, never invented.
  if(!u||typeof u!=="object")return null;
  const i=posNum(u.input_tokens),o=posNum(u.output_tokens),t=posNum(u.total_tokens);
  const bits=[];
  if(t!=null)bits.push(fmtTok(t)+" tok");
  else if(i!=null&&o!=null)bits.push(fmtTok(i)+" in / "+fmtTok(o)+" out");
  else if(i!=null)bits.push(fmtTok(i)+" in");
  else if(o!=null)bits.push(fmtTok(o)+" out");
  const c=posNum(u.api_call_count);
  if(c!=null&&c>0)bits.push(c+" calls");
  return bits.length?bits.join(" · "):null;
}
function diffStats(d){ // Round-16: live worktree diff; null degrades to unavailable upstream.
  if(!d||typeof d!=="object")return null;
  const f=posNum(d.file_count),ins=posNum(d.insertions),del=posNum(d.deletions);
  const files=Array.isArray(d.files)?d.files.map(x=>String(x)):[];
  if(f==null&&ins==null&&del==null&&!files.length)return null;
  return {stat:(f==null?"?":f)+" files"+(ins!=null&&del!=null?" · +"+ins+" / -"+del:""),files:files,
    dirty:typeof d.dirty==="boolean"?d.dirty:null};
}
