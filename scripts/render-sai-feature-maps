SESSIONS_JS = """
const STALE_MIN=30;
// Per-refresh GitHub enrichment budget (anon quota 60/hr; stay well under).
const REQUEST_BUDGET=24;
const GH_API="https://api.github.com/repos/Dezocode/Sai";
