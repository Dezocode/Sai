#!/usr/bin/env bash
# Authorization + trailer gate. Reconstructs from tracked truth + session cache.
# Session is not sufficient; verify-agent-authorization rechecks leases/paths.
[ "${SAI_AGENT_REPORT_ACTIVE:-}" = "1" ] && exit 0
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
exec "$REPO_ROOT/scripts/verify-agent-authorization" --pre-commit
