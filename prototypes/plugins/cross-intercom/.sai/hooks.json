"subagentStop":[{"command":"prototypes/plugins/cross-intercom/.sai/hooks/grokbot.sh","args":["hook"],"failClosed":false,"timeout":30,"matcher":".*"}],
"beforeShellExecution":[{"command":"prototypes/plugins/cross-intercom/.sai/hooks/grokbot.sh","args":["hook"],"failClosed":false,"timeout":30,"matcher":".*"}],
"afterShellExecution":[{"command":"prototypes/plugins/cross-intercom/.sai/hooks/grokbot.sh","args":["hook"],"failClosed":false,"timeout":30,"matcher":".*"}],
"beforeMCPExecution":[{"command":"prototypes/plugins/cross-intercom/.sai/hooks/grokbot.sh","args":["hook"],"failClosed":false,"timeout":30}],
"afterMCPExecution":[{"command":"prototypes/plugins/cross-intercom/.sai/hooks/grokbot.sh","args":["hook"],"failClosed":false,"timeout":30}],
