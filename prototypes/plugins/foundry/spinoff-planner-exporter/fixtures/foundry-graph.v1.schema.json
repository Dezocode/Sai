{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foundry dependency graph v1",
  "type": "object",
  "required": ["schema_version", "plugin_id", "prototype_root", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plugin_id": { "type": "string", "minLength": 1 },
    "prototype_root": {
      "type": "string",
      "pattern": "^prototypes/plugins/[^/]+$"
    },
    "entry_nodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "classification"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["file", "go_import", "service", "package"]
          },
          "classification": {
            "type": "string",
            "enum": [
              "REUSE",
              "PROMOTE",
              "EXPORT",
              "REMOTE",
              "PROMOTE_SHARED",
              "DROP",
              "UNKNOWN"
            ]
          },
          "path": { "type": "string" },
          "import_path": { "type": "string" },
          "name": { "type": "string" },
          "contract": { "type": "string" },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rewrite_to": { "type": "string" }
        }
      }
    }
  }
}
