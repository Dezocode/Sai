# Copy to a private environment file; never commit the filled-in copy.
# No secret is required for a loopback gateway. If auth is added later, use an
# OS secret store or an injected environment variable, never this file.

# Canonical Mac gateway. Do not point Hostinger at a second inference service.
PISAI_GATEWAY_BASE_URL=http://127.0.0.1:11437
PISAI_GATEWAY_HEALTH_PATH=/proxy/health
PISAI_GATEWAY_STATUS_PATH=/proxy/runtime

# Pi sends all OpenAI-compatible inference here.
PISAI_PI_API_BASE_URL=http://127.0.0.1:11437/v1
PISAI_ROUTE_HEADER=x-pisai-task
PISAI_REQUEST_ID_HEADER=x-pisai-request-id

# Role aliases are catalog keys, not download instructions or credentials.
PISAI_CODING_MODEL=qwen3.8-ridge-gguf
PISAI_VISION_MODEL=ornith-1.5-9b-ad-q4-k-iq4-xs-vision
PISAI_COMPACTOR_MODEL=qwen3.5-2b-4bit-mlx-compactor
PISAI_CONTEXT_TOKENS=32768
PISAI_ACTIVE_SPEC_MAX_TOKENS=3000
PISAI_SINGLE_RESIDENT=1

# Durable Pi memory is local to the Pi agent directory.
PISAI_MEMORY_DIR=${PI_CODING_AGENT_DIR}/memory/pisai
PISAI_COMPACTION_MODE=hierarchical-chunked

# Telemetry contract. Values are metadata only; do not put tokens here.
PISAI_TELEMETRY_SCHEMA=ollama-pisai-hooks.v1
PISAI_NOOS_SCHEMA=noos-compatible.v1
PISAI_NOOS_REVISION=2
PISAI_ROUTER_REQUIRED=1

# Safety gates. A route transition must fail closed at or above these limits.
PISAI_BLOCK_SWAP_RATIO=0.85
PISAI_BLOCK_RAM_RATIO=0.97
