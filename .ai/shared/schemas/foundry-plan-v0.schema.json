{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Dezocode/Sai/.ai/shared/schemas/foundry-plan-v0.schema.json",
  "title": "Foundry graduation plan v0",
  "type": "object",
  "required": ["plan_id", "schema_version", "repo", "base", "prototype_head", "graph_hash", "operations", "dispositions"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"type": "integer", "const": 1},
    "repo": {"type": "string", "minLength": 1},
    "base": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "prototype_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "graph_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "idempotency_key", "owner_confirmed"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["integrate", "spinoff", "delete-archive"]},
          "idempotency_key": {"type": "string", "minLength": 1},
          "prototype_path": {"type": "string"},
          "target_branch": {"type": "string"},
          "spinoff_name": {"type": "string"},
          "owner_confirmed": {"type": "boolean"}
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "disposition"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "disposition": {"type": "string", "enum": ["REUSE", "PROMOTE", "EXPORT", "REMOTE", "PROMOTE_SHARED", "DROP"]}
        }
      }
    },
    "recovery": {"type": "array", "items": {"type": "string"}}
  }
}
